@model LegendPay.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    var invalid = !ViewContext.ModelState.IsValid;
}

<div class="w-full max-w-md bg-surface-container-lowest border border-outline-variant p-8 rounded-xl shadow-lg relative z-10">
    <div class="flex justify-center mb-6">
        <div class="w-16 h-16 rounded-xl bg-primary-container/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-[32px] text-primary" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
        </div>
    </div>

    <div class="text-center mb-8">
        <h1 class="font-headline text-[32px] font-bold text-on-surface leading-tight tracking-tight mb-2">Forgot password?</h1>
        <p class="font-body text-[16px] text-on-surface-variant">
            Enter the email linked to your account and we'll send you a 6-digit code to reset your password.
        </p>
    </div>

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="space-y-6">
        <div class="space-y-2">
            <label class="font-label text-[14px] font-semibold text-on-surface-variant ml-1">Email address</label>
            <input asp-for="Email" type="email" autofocus placeholder="you@example.com"
                   class="w-full h-12 px-4 border-2 rounded-lg bg-surface-container-lowest text-on-surface focus:ring-0 focus:border-primary border-surface-variant transition-colors" />
            <span asp-validation-for="Email" class="font-label text-[12px] font-medium text-error ml-1"></span>
        </div>

        @if (invalid)
        {
            <div asp-validation-summary="ModelOnly" class="font-label text-[12px] font-medium text-error"></div>
        }

        <button type="submit" class="w-full h-12 bg-primary text-on-primary font-semibold rounded-lg hover:bg-primary-container transition-all duration-200 shadow-md flex items-center justify-center gap-2">
            Send reset code
        </button>

        <div class="pt-2 text-center">
            <a asp-controller="Auth" asp-action="Login" class="font-label text-[14px] font-semibold text-primary hover:underline">Back to login</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
