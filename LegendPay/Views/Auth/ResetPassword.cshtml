@model LegendPay.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    var invalid = !ViewContext.ModelState.IsValid;
    var emailFailed = TempData["OtpEmailFailed"] as bool? ?? false;
}

<div class="w-full max-w-md bg-surface-container-lowest border border-outline-variant p-8 rounded-xl shadow-lg relative z-10">
    <div class="flex justify-center mb-6">
        <div class="w-16 h-16 rounded-xl bg-primary-container/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-[32px] text-primary" style="font-variation-settings: 'FILL' 1;">password</span>
        </div>
    </div>

    <div class="text-center mb-8">
        <h1 class="font-headline text-[32px] font-bold text-on-surface leading-tight tracking-tight mb-2">Reset password</h1>
        <p class="font-body text-[16px] text-on-surface-variant">
            Enter the code sent to <br />
            <span class="font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(Model.Email) ? "your email address" : Model.Email)</span>
            and choose a new password.
        </p>
    </div>

    @if (emailFailed)
    {
        <div class="mb-6 flex items-start gap-2 p-3 rounded-lg bg-error-container text-on-error-container">
            <span class="material-symbols-outlined text-[18px]">warning</span>
            <p class="font-label text-[13px]">We couldn't send the email right now. If you don't have your code, request a new one.</p>
        </div>
    }

    <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="space-y-5">
        <input type="hidden" asp-for="Email" />

        <div class="space-y-2">
            <label class="font-label text-[14px] font-semibold text-on-surface-variant ml-1">Verification code</label>
            <input asp-for="OtpCode" inputmode="numeric" maxlength="6" autofocus placeholder="6-digit code"
                   class="w-full h-12 px-4 text-center tracking-[0.5em] font-bold border-2 rounded-lg bg-surface-container-lowest text-on-surface focus:ring-0 focus:border-primary border-surface-variant transition-colors" />
            <span asp-validation-for="OtpCode" class="font-label text-[12px] font-medium text-error ml-1"></span>
        </div>

        <div class="space-y-2">
            <label class="font-label text-[14px] font-semibold text-on-surface-variant ml-1">New password</label>
            <input asp-for="NewPassword" type="password" placeholder="••••••••"
                   class="w-full h-12 px-4 border-2 rounded-lg bg-surface-container-lowest text-on-surface focus:ring-0 focus:border-primary border-surface-variant transition-colors" />
            <span asp-validation-for="NewPassword" class="font-label text-[12px] font-medium text-error ml-1"></span>
        </div>

        <div class="space-y-2">
            <label class="font-label text-[14px] font-semibold text-on-surface-variant ml-1">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" placeholder="••••••••"
                   class="w-full h-12 px-4 border-2 rounded-lg bg-surface-container-lowest text-on-surface focus:ring-0 focus:border-primary border-surface-variant transition-colors" />
            <span asp-validation-for="ConfirmPassword" class="font-label text-[12px] font-medium text-error ml-1"></span>
        </div>

        @if (invalid)
        {
            <div asp-validation-summary="ModelOnly" class="font-label text-[12px] font-medium text-error"></div>
        }

        <button type="submit" class="w-full h-12 bg-primary text-on-primary font-semibold rounded-lg hover:bg-primary-container transition-all duration-200 shadow-md flex items-center justify-center gap-2">
            Reset password
        </button>

        <div class="pt-2 text-center">
            <a asp-controller="Auth" asp-action="ForgotPassword" class="font-label text-[14px] font-semibold text-primary hover:underline">Request a new code</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
