@using LegendPay.Models.ViewModels
@model LegendPay.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — LegendPay</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Sora:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Auth/login.css" />
</head>
<body>

    <div class="login-page">

        <div class="login-top">
            <div class="login-logo">
                <img src="/screenicon/Background.svg" alt="LegendPay Logo" />
            </div>
            <h1 class="login-brand">LegendPay</h1>
            <p class="login-welcome">Welcome back</p>
        </div>

        <div class="login-card">

            <div asp-validation-summary="ModelOnly" class="error-summary"></div>

            <form asp-action="Login" method="post">

                <div class="form-group">
                    <label class="form-label">PHONE OR EMAIL</label>
                    <div class="input-wrapper">
                        <input asp-for="PhoneNumberOrEmail" class="form-input" placeholder="Enter your credentials" />
                        <span class="input-icon-right">&#128100;</span>
                    </div>
                    <span asp-validation-for="PhoneNumberOrEmail" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">PASSWORD</label>
                    <div class="input-wrapper">
                        <input asp-for="Password" type="password" class="form-input" placeholder="••••••••" id="passwordInput" />
                        <span class="input-icon-right toggle-pw" onclick="togglePassword()">&#128065;</span>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-extras">
                    <label class="remember-me">
                        <input type="checkbox" id="rememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">Log in ›</button>

            </form>

            <div class="divider">
                <span>OR SIGN IN WITH</span>
            </div>

            <div class="social-row">
                <button class="social-btn google-btn">
                    <img src="/screenicon/google.png" alt="Google" width="18" />
                    Google
                </button>
                <button class="social-btn biometrics-btn">
                    <img src="/screenicon/fingerprint.png" alt="Biometrics" width="18" />
                    Biometrics
                </button>
            </div>

        </div>

        <p class="signup-link">New to LegendPay? <a asp-controller="Auth" asp-action="SignUp">Create an account</a></p>

    </div>

    <script src="~/js/Auth/login.js"></script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</body>
</html>