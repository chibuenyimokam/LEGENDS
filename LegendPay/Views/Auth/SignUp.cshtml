@using LegendPay.Models.ViewModels
@model LegendPay.Models.ViewModels.SignUpViewModel

@{
    ViewData["Title"] = "SignUp";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create an Account — LegendPay</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Sora:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Auth/signup.css" />
</head>
<body>

    <div class="signup-page">

        <div class="signup-card">

        
            <a asp-controller="Home" asp-action="Onboarding" class="back-link">
                ← BACK
            </a>

        
            <div class="signup-header">
                <div class="signup-logo">
                    <img src="/screenicon/Background.svg" alt="LegendPay Logo" />
                </div>
                <div>
                    <h1 class="signup-title">Create an account</h1>
                    <p class="signup-subtitle">Join the future of Nigerian digital payments.</p>
                </div>
            </div>

            <!-- Validation summary -->
            <div asp-validation-summary="ModelOnly" class="error-summary"></div>

        
            <form asp-action="SignUp" method="post">

                <div class="form-group">
                    <label class="form-label">FIRST NAME</label>
                    <div class="input-wrapper">
                        <span class="input-icon">&#128100;</span>
                        <input asp-for="FirstName" class="form-input" placeholder="First name" />
                    </div>
                    <span asp-validation-for="FirstName" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">LAST NAME</label>
                    <div class="input-wrapper">
                        <span class="input-icon">&#128100;</span>
                        <input asp-for="LastName" class="form-input" placeholder="Last name" />
                    </div>
                    <span asp-validation-for="LastName" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">PHONE NUMBER</label>
                    <div class="input-wrapper phone-wrapper">
                        <span class="phone-code">+234</span>
                        <span class="phone-divider"></span>
                        <input asp-for="PhoneNumber" class="form-input phone-input" placeholder="801 234 5678" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">EMAIL ADDRESS</label>
                    <div class="input-wrapper">
                        <span class="input-icon">&#9993;</span>
                        <input asp-for="Email" class="form-input" placeholder="example@legendpay.com" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group half">
                        <label class="form-label">PASSWORD</label>
                        <div class="input-wrapper">
                            <input asp-for="Password" type="password" class="form-input" placeholder="  ••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <div class="form-group half">
                        <label class="form-label">CONFIRM</label>
                        <div class="input-wrapper">
                            <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="  ••••••••" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                </div>

            
                <div class="wallet-notice" id="walletNotice">
                    <div class="wallet-checkbox" id="walletCheckbox" onclick="toggleWallet()">
                        <span class="checkmark" id="checkmark" style="display:none;">&#10003;</span>
                    </div>
                    <div class="wallet-text">
                        <strong>Auto-wallet created on signup — wallet ID assigned instantly.</strong>
                        <p>Start sending and receiving funds immediately without extra verification steps.</p>
                    </div>
                </div>

                <button type="submit" class="btn-create">Create account ›</button>

            </form>

            <p class="login-link">Have an account? <a asp-controller="Auth" asp-action="Login">Log in</a></p>

        </div>

    
        <div class="signup-footer">
            <p class="brand-name">LegendPay</p>
            <p class="security-note">SECURE 256-BIT ENCRYPTION &nbsp;&nbsp; CBN LICENSED BILLER</p>
        </div>

    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    <script src="~/js/Auth/signup.js"></script> 
</body>
</html>