<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LegendPay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/dashboard-transactions.css" asp-append-version="true" />
</head>
<body>

    <div class="dashboard-wrapper">
        <!-- Persistent Portal Sidebar Navigation -->
        <aside class="app-sidebar">
            <div>
                <div class="brand-section">
                    <h1 class="brand-title">User central</h1>
                    <span class="brand-subtitle">Management Portal</span>
                </div>

                <nav class="nav-menu">
                    <a asp-controller="Accounts" asp-action="HomePage" class="nav-menu-link">
                        <i class="bi bi-grid-1x2-fill"></i> <span>Overview</span>
                    </a>
                    <a href="#" class="nav-menu-link active">
                        <i class="bi bi-wallet2"></i> <span>Transactions</span>
                    </a>
                    <a href="#" class="nav-menu-link">
                        <i class="bi bi-bar-chart-line"></i> <span>Analytics</span>
                    </a>
                    <a href="#" class="nav-menu-link">
                        <i class="bi bi-chat-left-text"></i> <span>Support</span>
                    </a>
                </nav>
            </div>

            <div class="sidebar-footer">
                <div class="account-status-card">
                    <span class="status-pulse-dot"></span>
                    <span>Account Status: Active</span>
                </div>

                <div class="footer-action-links">
                    <a href="#" class="footer-link">
                        <i class="bi bi-gear"></i> <span>Settings</span>
                    </a>
                    <a asp-controller="Home" asp-action="Onboarding" class="footer-link logout">
                        <i class="bi bi-box-arrow-left"></i> <span>Logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Render View injection window -->
        <main class="content-viewport">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>