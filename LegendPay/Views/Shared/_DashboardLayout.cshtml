@using System.Security.Claims
@{
    var firstName = User.FindFirstValue(ClaimTypes.GivenName);
    var lastName = User.FindFirstValue(ClaimTypes.Surname);
    var fullName = $"{firstName} {lastName}".Trim();
    var initials = string.Concat(new[] { firstName, lastName }
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Select(s => char.ToUpperInvariant(s![0])));
    if (string.IsNullOrEmpty(initials)) initials = "?";
    var accountType = ViewData["AccountType"] as string ?? "Personal Account";
}
@functions {
    private string NavClass(string controller, string action)
    {
        var route = ViewContext.RouteData.Values;
        var active = string.Equals(route["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(route["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase);

        const string baseClass = "flex items-center px-3 py-2 gap-3 text-sm font-medium transition-colors";
        return active
            ? $"sidebar-active {baseClass}"
            : $"text-on-surface-variant hover:text-slate-900 {baseClass}";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>LegendPay | @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "background": "#f9fafb",
                      "surface": "#ffffff",
                      "primary": "#0b4a8f",
                      "on-primary": "#ffffff",
                      "primary-container": "#d1e4ff",
                      "on-primary-container": "#001d36",
                      "primary-fixed": "#d1e4ff",
                      "on-surface": "#111827",
                      "on-surface-variant": "#4b5563",
                      "surface-container-lowest": "#ffffff",
                      "surface-container-low": "#f1f4f9",
                      "surface-variant": "#e0e3e8",
                      "outline": "#74777f",
                      "outline-variant": "#e5e7eb",
                      "naira-green": "#008751",
                      "error": "#ba1a1a",
                      "slate-50": "#f8fafc",
                      "slate-100": "#f1f5f9",
                      "slate-200": "#e2e8f0",
                      "slate-900": "#0f172a"
              },
              "borderRadius": {
                      "DEFAULT": "0.375rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "margin-desktop": "40px",
                      "container-max": "1200px"
              },
              "fontFamily": {
                      "headline": ["Inter", "sans-serif"],
                      "display": ["Inter", "sans-serif"],
                      "body": ["Inter", "sans-serif"],
                      "label": ["Inter", "sans-serif"],
                      "headline-md": ["Inter", "sans-serif"],
                      "display-lg": ["Inter", "sans-serif"],
                      "label-md": ["Inter", "sans-serif"],
                      "label-sm": ["Inter", "sans-serif"],
                      "body-sm": ["Inter", "sans-serif"]
              },
              "fontSize": {
                      "display-lg": ["56px", { "lineHeight": "64px", "letterSpacing": "-0.02em", "fontWeight": "800" }],
                      "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                      "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }],
                      "label-sm": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }],
                      "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
              }
            },
          }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
            font-size: 20px;
        }

        .sidebar-active {
            position: relative;
            color: #0b4a8f;
        }

            .sidebar-active::before {
                content: '';
                position: absolute;
                left: -16px;
                top: 50%;
                transform: translateY(-50%);
                width: 3px;
                height: 16px;
                background-color: #0b4a8f;
                border-radius: 0 4px 4px 0;
            }

        .soft-elevation {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .tonal-elevation {
            box-shadow: 0 4px 20px rgba(11, 74, 143, 0.08);
        }

        table {
            border-collapse: separate;
            border-spacing: 0;
        }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">
    <aside class="fixed left-0 top-0 h-screen w-64 flex flex-col p-6 z-40 bg-surface border-r border-slate-200">
        <div class="mb-10">
            <h1 class="text-xl font-bold tracking-tight text-slate-900">LegendPay</h1>
        </div>
        <nav class="flex-1 space-y-1">
            <a asp-controller="Home" asp-action="HomePage" class="@NavClass("Home", "HomePage")">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a asp-controller="Home" asp-action="FundWallet" class="@NavClass("Home", "FundWallet")">
                <span class="material-symbols-outlined">account_balance_wallet</span>
                <span>Fund Wallet</span>
            </a>
            <a asp-controller="Home" asp-action="PayBills" class="@NavClass("Home", "PayBills")">
                <span class="material-symbols-outlined">payments</span>
                <span>Pay a Bill</span>
            </a>
            <a asp-controller="Home" asp-action="Subscriptions" class="@NavClass("Home", "Subscriptions")">
                <span class="material-symbols-outlined">event_repeat</span>
                <span>Subscriptions</span>
            </a>
            <a asp-controller="Home" asp-action="LegendPoints" class="@NavClass("Home", "LegendPoints")">
                <span class="material-symbols-outlined">stars</span>
                <span>Rewards</span>
            </a>
            <a asp-controller="Home" asp-action="History" class="@NavClass("Home", "History")">
                <span class="material-symbols-outlined">history</span>
                <span>History</span>
            </a>
            <div class="pt-4 pb-2">
                <p class="px-3 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest opacity-50">Account</p>
            </div>
            <a asp-controller="UserSupportChat" asp-action="UserSupport" class="@NavClass("UserSupportChat", "UserSupport")">
                <span class="material-symbols-outlined">contact_support</span>
                <span>Support</span>
            </a>
        </nav>
        <div class="mt-auto">
            <a asp-controller="Auth" asp-action="Logout" class="w-full bg-slate-900 text-white text-xs font-semibold py-2.5 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-[16px]">logout</span>
                Log Out
            </a>
        </div>
    </aside>

    <main class="ml-64 min-h-screen flex flex-col">
        <header class="flex justify-between items-center w-full px-10 py-4 sticky top-0 z-50 bg-background/80 backdrop-blur-md border-b border-slate-200">
            <div class="flex items-center gap-6 flex-1">
                <div class="relative w-full max-w-sm">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                    <input class="w-full pl-10 pr-4 py-1.5 bg-slate-100/50 border-none rounded-md focus:ring-1 focus:ring-slate-300 text-sm placeholder-on-surface-variant/60" placeholder="Search anything..." type="text" />
                </div>
            </div>
            <div class="flex items-center gap-5">
                <div class="relative" id="notifWrapper">
                    <button type="button" id="notifBtn" class="p-1.5 text-on-surface-variant hover:text-slate-900 transition-colors relative" aria-label="Notifications">
                        <span class="material-symbols-outlined">notifications</span>
                        <span id="notifBadge" class="hidden absolute -top-0.5 -right-0.5 min-w-[16px] h-4 px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center">0</span>
                    </button>
                    <div id="notifPanel" class="hidden absolute right-0 mt-2 w-80 bg-white border border-slate-200 rounded-xl shadow-xl z-[60] overflow-hidden">
                        <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
                            <p class="text-sm font-bold text-slate-900">Notifications</p>
                            <button type="button" id="notifMarkAll" class="text-[11px] font-semibold text-primary hover:underline">Mark all read</button>
                        </div>
                        <div id="notifList" class="max-h-96 overflow-y-auto divide-y divide-slate-50">
                            <p class="px-4 py-8 text-center text-sm text-on-surface-variant">Loading…</p>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-3 pl-5 border-l border-slate-200">
                    <div class="text-right">
                        <p class="text-sm font-semibold text-slate-900">@fullName</p>
                        <p class="text-[11px] text-on-surface-variant font-medium">@accountType</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-[11px] font-bold text-slate-600 uppercase">@initials</div>
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="mt-auto flex justify-between items-center w-full px-10 py-6 border-t border-slate-200">
            <p class="text-[11px] font-medium text-on-surface-variant/60">© @DateTime.Now.Year LegendPay • Licensed by CBN</p>
            <div class="flex gap-8">
                <a asp-controller="Home" asp-action="Privacy" class="text-[11px] font-bold text-on-surface-variant/60 hover:text-slate-900 transition-colors">Privacy</a>
                <a href="#" class="text-[11px] font-bold text-on-surface-variant/60 hover:text-slate-900 transition-colors">Terms</a>
                <a href="#" class="text-[11px] font-bold text-on-surface-variant/60 hover:text-slate-900 transition-colors">Security</a>
            </div>
        </footer>
    </main>

    <div id="copyToast" class="fixed bottom-10 left-1/2 -translate-x-1/2 px-6 py-3 bg-slate-900 text-white rounded-lg text-sm opacity-0 pointer-events-none transition-opacity duration-300 z-[100] shadow-2xl flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">check_circle</span>
        Account number copied
    </div>

    <script>
        function copyToClipboard(text) {
            if (text && navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text);
            }

            const toast = document.getElementById('copyToast');
            if (!toast) return;

            toast.style.opacity = '1';
            setTimeout(() => { toast.style.opacity = '0'; }, 2000);
        }
    </script>

    <script>
        (function () {
            const btn = document.getElementById('notifBtn');
            const panel = document.getElementById('notifPanel');
            const badge = document.getElementById('notifBadge');
            const list = document.getElementById('notifList');
            const markAll = document.getElementById('notifMarkAll');
            const wrapper = document.getElementById('notifWrapper');
            if (!btn) return;

            const icons = {
                WalletFunded: 'account_balance_wallet',
                BillPaid: 'receipt_long',
                Reminder: 'schedule',
                AutoPay: 'autorenew',
                CashbackCredited: 'redeem',
                LowBalance: 'warning',
                SupportReply: 'support_agent'
            };

            const links = {
                WalletFunded: '/Home/FundWallet',
                CashbackCredited: '/Home/FundWallet',
                LowBalance: '/Home/FundWallet',
                BillPaid: '/Home/History',
                Reminder: '/Home/Subscriptions',
                AutoPay: '/Home/Subscriptions',
                SupportReply: '/UserSupportChat/UserSupport'
            };

            function linkFor(n) {
                if (n.type === 'SupportReply' && n.referenceId) {
                    return '/UserSupportChat/OpenChat?chatId=' + n.referenceId;
                }
                return links[n.type] || '/Home/HomePage';
            }

            function renderCount(count) {
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            async function loadCount() {
                try {
                    const res = await fetch('/Notification/GetUnreadCount');
                    const data = await res.json();
                    renderCount(data.count || 0);
                } catch { }
            }

            async function loadList() {
                list.innerHTML = '<p class="px-4 py-8 text-center text-sm text-on-surface-variant">Loading…</p>';
                try {
                    const res = await fetch('/Notification/GetAll');
                    const data = await res.json();
                    const items = data.notifications || [];
                    if (!items.length) {
                        list.innerHTML = '<p class="px-4 py-10 text-center text-sm text-on-surface-variant">You\'re all caught up.</p>';
                        return;
                    }
                    list.innerHTML = items.map(n => `
                        <a href="${linkFor(n)}" data-id="${n.id}" class="notif-item flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition-colors ${n.isRead ? '' : 'bg-blue-50/40'}">
                            <span class="material-symbols-outlined text-[20px] text-primary mt-0.5">${icons[n.type] || 'notifications'}</span>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm text-slate-800 leading-snug">${n.message}</p>
                                <p class="text-[11px] text-on-surface-variant mt-1">${n.date} • ${n.time}</p>
                            </div>
                            ${n.isRead ? '' : '<span class="w-2 h-2 rounded-full bg-blue-500 mt-1.5"></span>'}
                        </a>`).join('');

                    list.querySelectorAll('.notif-item').forEach(a => {
                        a.addEventListener('click', function (e) {
                            e.preventDefault();
                            const id = this.getAttribute('data-id');
                            const href = this.getAttribute('href');
                            fetch('/Notification/MarkRead/' + id, { method: 'POST' })
                                .catch(() => { })
                                .finally(() => { window.location.href = href; });
                        });
                    });
                } catch {
                    list.innerHTML = '<p class="px-4 py-8 text-center text-sm text-on-surface-variant">Could not load notifications.</p>';
                }
            }

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const open = !panel.classList.contains('hidden');
                if (open) { panel.classList.add('hidden'); return; }
                panel.classList.remove('hidden');
                loadList();
            });

            document.addEventListener('click', function (e) {
                if (wrapper && !wrapper.contains(e.target)) panel.classList.add('hidden');
            });

            markAll.addEventListener('click', async function (e) {
                e.stopPropagation();
                try {
                    await fetch('/Notification/MarkAllRead', { method: 'POST' });
                    renderCount(0);
                    loadList();
                } catch { }
            });

            loadCount();
            setInterval(loadCount, 60000);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
