@using System.Security.Claims
@{
    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "Admin";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Admin";
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Take(2)
        .Select(s => char.ToUpperInvariant(s[0])));
    if (string.IsNullOrEmpty(initials)) initials = "A";
}
@functions {
    private string NavClass(string controller, string action)
    {
        var route = ViewContext.RouteData.Values;
        var active = string.Equals(route["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(route["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase);

        const string baseClass = "flex items-center px-3 py-2 gap-3 text-sm font-medium transition-colors";
        return active
            ? $"sidebar-active {baseClass}"
            : $"text-on-surface-variant hover:text-slate-900 {baseClass}";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>LegendPay Admin | @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "background": "#f9fafb",
                      "surface": "#ffffff",
                      "primary": "#0b4a8f",
                      "on-primary": "#ffffff",
                      "on-surface": "#111827",
                      "on-surface-variant": "#4b5563",
                      "outline-variant": "#e5e7eb",
                      "slate-50": "#f8fafc",
                      "slate-100": "#f1f5f9",
                      "slate-200": "#e2e8f0",
                      "slate-900": "#0f172a"
              },
              "borderRadius": {
                      "DEFAULT": "0.375rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "fontFamily": {
                      "headline": ["Inter", "sans-serif"],
                      "body": ["Inter", "sans-serif"]
              }
            }
          }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
            font-size: 20px;
        }

        .sidebar-active {
            position: relative;
            color: #0b4a8f;
        }

            .sidebar-active::before {
                content: '';
                position: absolute;
                left: -16px;
                top: 50%;
                transform: translateY(-50%);
                width: 3px;
                height: 16px;
                background-color: #0b4a8f;
                border-radius: 0 4px 4px 0;
            }

        table {
            border-collapse: separate;
            border-spacing: 0;
        }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">
    <aside class="fixed left-0 top-0 h-screen w-64 flex flex-col p-6 z-40 bg-surface border-r border-slate-200">
        <div class="mb-10">
            <h1 class="text-xl font-bold tracking-tight text-slate-900">LegendPay</h1>
            <p class="text-xs text-on-surface-variant font-medium uppercase tracking-widest mt-1 opacity-60">Admin Console</p>
        </div>
        <nav class="flex-1 space-y-1">
            <a asp-controller="Admin" asp-action="Dashboard" class="@NavClass("Admin", "Dashboard")">
                <span class="material-symbols-outlined">monitoring</span>
                <span>Monitoring</span>
            </a>
            <a asp-controller="Admin" asp-action="UserRegistry" class="@NavClass("Admin", "UserRegistry")">
                <span class="material-symbols-outlined">group</span>
                <span>User Registry</span>
            </a>
            <a asp-controller="Admin" asp-action="Transactions" class="@NavClass("Admin", "Transactions")">
                <span class="material-symbols-outlined">payments</span>
                <span>Transactions</span>
            </a>
            <a asp-controller="AdminSupportChat" asp-action="UserSupport" class="@NavClass("AdminSupportChat", "UserSupport")">
                <span class="material-symbols-outlined">gavel</span>
                <span>Disputes</span>
            </a>
            <a asp-controller="Admin" asp-action="Settlement" class="@NavClass("Admin", "Settlement")">
                <span class="material-symbols-outlined">account_balance</span>
                <span>Settlements</span>
            </a>
            <a asp-controller="Admin" asp-action="Reports" class="@NavClass("Admin", "Reports")">
                <span class="material-symbols-outlined">analytics</span>
                <span>Reports</span>
            </a>
            <a asp-controller="Admin" asp-action="LegendPoints" class="@NavClass("Admin", "LegendPoints")">
                <span class="material-symbols-outlined">stars</span>
                <span>Legend Points</span>
            </a>
            <div class="pt-4 pb-2">
                <p class="px-3 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest opacity-50">System</p>
            </div>
            <a asp-controller="Admin" asp-action="AuditLogs" class="@NavClass("Admin", "AuditLogs")">
                <span class="material-symbols-outlined">receipt_long</span>
                <span>Audit Logs</span>
            </a>
            <a asp-controller="Admin" asp-action="Settings" class="@NavClass("Admin", "Settings")">
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
            </a>
        </nav>
        <div class="mt-auto">
            <form asp-controller="Admin" asp-action="Logout" method="post">
                <button type="submit" class="w-full bg-slate-900 text-white text-xs font-semibold py-2.5 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-[16px]">logout</span>
                    Log Out
                </button>
            </form>
        </div>
    </aside>

    <main class="ml-64 min-h-screen flex flex-col">
        <header class="flex justify-between items-center w-full px-10 py-4 sticky top-0 z-50 bg-background/80 backdrop-blur-md border-b border-slate-200">
            <div class="flex items-center gap-6 flex-1">
                <form asp-area="Admin" asp-controller="Admin" asp-action="UserRegistry" method="get" class="relative w-full max-w-sm">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                    <input name="search" value="@(Context.Request.Query["search"])" class="w-full pl-10 pr-4 py-1.5 bg-slate-100/50 border-none rounded-md focus:ring-1 focus:ring-slate-300 text-sm placeholder-on-surface-variant/60" placeholder="Search users by name, email, phone…" type="text" />
                </form>
            </div>
            <div class="flex items-center gap-5">
                <div class="relative" id="adminNotifWrapper">
                    <button type="button" id="adminNotifBtn" class="p-1.5 text-on-surface-variant hover:text-slate-900 transition-colors relative" aria-label="Notifications">
                        <span class="material-symbols-outlined">notifications</span>
                        <span id="adminNotifBadge" class="hidden absolute -top-0.5 -right-0.5 min-w-[16px] h-4 px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center">0</span>
                    </button>
                    <div id="adminNotifPanel" class="hidden absolute right-0 mt-2 w-80 bg-white border border-slate-200 rounded-xl shadow-xl z-[60] overflow-hidden">
                        <div class="px-4 py-3 border-b border-slate-100">
                            <p class="text-sm font-bold text-slate-900">Notifications</p>
                        </div>
                        <div id="adminNotifList" class="max-h-96 overflow-y-auto">
                            <p class="px-4 py-8 text-center text-sm text-on-surface-variant">Loading…</p>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-3 pl-5 border-l border-slate-200">
                    <div class="text-right">
                        <p class="text-sm font-semibold text-slate-900">@fullName</p>
                        <p class="text-[11px] text-on-surface-variant font-medium uppercase tracking-wider">@role</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-slate-900 border border-slate-200 flex items-center justify-center text-[11px] font-bold text-white uppercase">@initials</div>
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="mt-auto flex justify-between items-center w-full px-10 py-6 border-t border-slate-200">
            <p class="text-[11px] font-medium text-on-surface-variant/60">© @DateTime.Now.Year LegendPay Admin Console • Restricted Access</p>
            <p class="text-[11px] font-medium text-on-surface-variant/60">All actions are logged</p>
        </footer>
    </main>

    <script>
        (function () {
            const btn = document.getElementById('adminNotifBtn');
            const panel = document.getElementById('adminNotifPanel');
            const badge = document.getElementById('adminNotifBadge');
            const list = document.getElementById('adminNotifList');
            const wrapper = document.getElementById('adminNotifWrapper');
            if (!btn) return;

            const detailUrl = '@Url.Action("AdminSupport", "AdminSupportChat")';

            function renderBadge(count) {
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            function renderList(items) {
                if (!items.length) {
                    list.innerHTML = '<p class="px-4 py-10 text-center text-sm text-on-surface-variant">No new notifications.</p>';
                    return;
                }
                list.innerHTML = items.map(function (i) {
                    return `
                        <a href="${detailUrl}?chatId=${i.chatId}" class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0">
                            <span class="material-symbols-outlined text-[20px] text-primary mt-0.5">forum</span>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm text-slate-800 font-medium truncate">${i.subject}</p>
                                <p class="text-[11px] text-on-surface-variant mt-0.5">New message from ${i.user}</p>
                            </div>
                        </a>`;
                }).join('');
            }

            async function loadBadge() {
                try {
                    const res = await fetch('/AdminSupportChat/OpenCount');
                    const data = await res.json();
                    renderBadge(data.count || 0);
                } catch { }
            }

            async function loadList() {
                list.innerHTML = '<p class="px-4 py-8 text-center text-sm text-on-surface-variant">Loading…</p>';
                try {
                    const res = await fetch('/AdminSupportChat/Awaiting');
                    const data = await res.json();
                    renderList(data.items || []);
                    renderBadge((data.items || []).length);
                } catch {
                    list.innerHTML = '<p class="px-4 py-8 text-center text-sm text-on-surface-variant">Could not load notifications.</p>';
                }
            }

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const open = !panel.classList.contains('hidden');
                if (open) { panel.classList.add('hidden'); return; }
                panel.classList.remove('hidden');
                loadList();
            });
            document.addEventListener('click', function (e) {
                if (wrapper && !wrapper.contains(e.target)) panel.classList.add('hidden');
            });

            loadBadge();
            setInterval(loadBadge, 60000);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
