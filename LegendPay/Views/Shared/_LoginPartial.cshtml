@if (ViewBag.FullName != null)
{
    <form asp-controller="Auth" asp-action="LogOut" method="post" id="logoutForm" class="navbar-right">
        <ul>
             <li>
                Hello @ViewBag.FullName!
                </li>
                <li>
                    <button class="btn btn-link nav-link text-dark" asp-controller="Auth" asp-action="LogOut" type="submit">Logout</button>
                    </li>
        </ul>
       
    </form>

}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li><a class="nav-link text-dark" asp-controller="Auth" asp-action="SignUp">SignUp</a></li>
        <li><a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Login</a></li>
    </ul>
}