@model LegendPay.Models.ViewModels.AdminLegendPointsViewModel
@{
    ViewData["Title"] = "Legend Points";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-7xl">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Legend Points Configuration</h2>
        <p class="text-sm text-on-surface-variant mt-0.5">Configure earning and redemption rules for the loyalty programme.</p>
    </div>

    @if (TempData["Saved"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm font-medium rounded-lg px-4 py-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            Configuration saved successfully.
        </div>
    }

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-surface border border-slate-200 p-6 rounded-xl">
            <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Total Points Issued</p>
            <h3 class="text-2xl font-bold text-slate-900">@Model.TotalPointsIssued.ToString("N0")</h3>
        </div>
        <div class="bg-surface border border-slate-200 p-6 rounded-xl">
            <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Total Redeemed</p>
            <h3 class="text-2xl font-bold text-slate-900">@Model.TotalRedeemedPoints.ToString("N0")</h3>
        </div>
        <div class="bg-surface border border-slate-200 p-6 rounded-xl">
            <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Active Point Holders</p>
            <h3 class="text-2xl font-bold text-slate-900">@Model.ActiveUsers.ToString("N0")</h3>
        </div>
    </section>

    <form asp-controller="Admin" asp-action="LegendPoints" method="post" class="bg-surface border border-slate-200 rounded-xl overflow-hidden max-w-3xl">
        <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Earning &amp; Redemption Rules</h3>
        </div>
        <div class="p-6 space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm [&_ul]:list-none [&_ul]:m-0 [&_ul]:p-0"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="EarnRateBelowThousandPct" class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Earn rate — bills below ₦1,000 (%)</label>
                    <input asp-for="EarnRateBelowThousandPct" type="number" step="0.01" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none" />
                    <span asp-validation-for="EarnRateBelowThousandPct" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="EarnRateAboveThousandPct" class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Earn rate — bills above ₦1,000 (%)</label>
                    <input asp-for="EarnRateAboveThousandPct" type="number" step="0.01" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none" />
                    <span asp-validation-for="EarnRateAboveThousandPct" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="RedemptionRatePct" class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Redemption cashback rate (%)</label>
                    <input asp-for="RedemptionRatePct" type="number" step="0.01" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none" />
                    <span asp-validation-for="RedemptionRatePct" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="MinimumRedemptionPoints" class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Minimum points to redeem</label>
                    <input asp-for="MinimumRedemptionPoints" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none" />
                    <span asp-validation-for="MinimumRedemptionPoints" class="text-red-600 text-xs"></span>
                </div>
            </div>
        </div>
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
            <p class="text-xs text-on-surface-variant">Last updated @Model.UpdatedAt.ToString("MMM d, yyyy")</p>
            <button type="submit" class="px-6 py-2.5 bg-primary text-white rounded-lg font-semibold text-sm flex items-center gap-2 hover:bg-[#083b72] transition-colors">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save Configuration
            </button>
        </div>
    </form>
</div>
