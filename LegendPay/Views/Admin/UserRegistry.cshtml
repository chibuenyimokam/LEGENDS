@using LegendPay.Helpers
@model LegendPay.Models.ViewModels.AdminUserRegistryViewModel
@{
    ViewData["Title"] = "User Registry";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">User Registry</h2>
            <p class="text-sm text-on-surface-variant mt-0.5">Manage and monitor all platform participants.</p>
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-surface border border-slate-200 rounded-lg px-4 py-3 text-center">
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Total</p>
                <p class="text-xl font-bold text-slate-900">@Model.TotalUsers.ToString("N0")</p>
            </div>
            <div class="bg-surface border border-slate-200 rounded-lg px-4 py-3 text-center">
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Verified</p>
                <p class="text-xl font-bold text-green-600">@Model.VerifiedUsers.ToString("N0")</p>
            </div>
            <div class="bg-surface border border-slate-200 rounded-lg px-4 py-3 text-center">
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Unverified</p>
                <p class="text-xl font-bold text-amber-600">@Model.UnverifiedUsers.ToString("N0")</p>
            </div>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="UserRegistry" method="get" class="bg-surface border border-slate-200 rounded-xl p-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div class="md:col-span-2">
                <label class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Search users</label>
                <input name="search" value="@Model.Search" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none" placeholder="Name, email or phone..." />
            </div>
            <div>
                <label class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Verification</label>
                <select name="status" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none">
                    <option value="all" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "all" ? "selected" : null)">All</option>
                    <option value="verified" selected="@(Model.Status == "verified" ? "selected" : null)">Verified</option>
                    <option value="unverified" selected="@(Model.Status == "unverified" ? "selected" : null)">Unverified</option>
                </select>
            </div>
            <div class="flex gap-2 items-end">
                <div class="flex-1">
                    <label class="text-xs font-semibold text-on-surface-variant mb-1.5 block">Min balance (₦)</label>
                    <input name="minBalance" value="@(Model.MinBalance?.ToString("0.##"))" type="number" step="0.01" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary outline-none" placeholder="0" />
                </div>
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg font-semibold text-sm flex items-center gap-2 hover:bg-[#083b72] transition-colors">
                    <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                    Apply
                </button>
            </div>
        </div>
    </form>

    <div class="bg-surface border border-slate-200 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">User</th>
                        <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Contact</th>
                        <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest text-right">Wallet Balance</th>
                        <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Status</th>
                        <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Joined</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-[11px] font-bold text-slate-600 uppercase">@user.Initials</div>
                                        <div>
                                            <p class="text-sm font-bold text-slate-900">@user.FullName</p>
                                            <p class="text-[11px] text-on-surface-variant uppercase">@user.Reference</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="text-sm text-slate-900">@user.Email</p>
                                    <p class="text-xs text-on-surface-variant">@user.PhoneNumber</p>
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-sm text-slate-900">₦@user.Balance.ToString("N2")</td>
                                <td class="px-6 py-4">
                                    @if (user.IsVerified)
                                    {
                                        <span class="px-2.5 py-1 bg-green-100 text-green-700 text-[11px] font-bold rounded uppercase tracking-wider border border-green-200">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 bg-amber-100 text-amber-700 text-[11px] font-bold rounded uppercase tracking-wider border border-amber-200">Unverified</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-sm text-on-surface-variant">@WatTime.FromUtc(user.CreatedAt).ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="px-6 py-12 text-center text-sm text-on-surface-variant" colspan="5">No users found for the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-between items-center">
            <p class="text-xs text-on-surface-variant font-medium">Showing @Model.ShownCount of @Model.TotalCount users</p>
            <div class="flex gap-2">
                @if (Model.HasPrevious)
                {
                    <a asp-controller="Admin" asp-action="UserRegistry" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-minBalance="@Model.MinBalance" asp-route-page="@(Model.Page - 1)" class="p-2 border border-slate-200 rounded hover:bg-slate-100 flex items-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                }
                else
                {
                    <span class="p-2 border border-slate-200 rounded opacity-30 flex items-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </span>
                }
                @if (Model.HasNext)
                {
                    <a asp-controller="Admin" asp-action="UserRegistry" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-minBalance="@Model.MinBalance" asp-route-page="@(Model.Page + 1)" class="p-2 border border-slate-200 rounded hover:bg-slate-100 flex items-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                }
                else
                {
                    <span class="p-2 border border-slate-200 rounded opacity-30 flex items-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </span>
                }
            </div>
        </div>
    </div>
</div>
