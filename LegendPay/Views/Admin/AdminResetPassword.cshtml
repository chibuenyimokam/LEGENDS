@model LegendPay.Models.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — LegendPay Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Sora:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Admin/AdminLogin.css" />
</head>
<body>

    <div class="admin-page">

        <div class="admin-brand">
            <div class="admin-brand-top">
                <img src="/screenicon/Background.svg" alt="LegendPay Logo" class="brand-img" />
                <span class="admin-brand-name">LegendPay</span>
            </div>
            <p class="admin-brand-label">Admin Portal</p>
        </div>

        <div class="admin-card">

            <h2 class="card-title">Reset password</h2>
            <p class="card-subtitle">Enter the code sent to <strong>@Model.Email</strong> and choose a new password.</p>

            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <form asp-action="ResetPassword" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label class="form-label">2FA Code</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </span>
                        <input asp-for="OtpCode" class="form-input otp-input" placeholder="000 000" maxlength="6" inputmode="numeric" autofocus />
                    </div>
                    <span asp-validation-for="OtpCode" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">New password</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input asp-for="NewPassword" type="password" class="form-input" placeholder="••••••••••••" />
                    </div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirm new password</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="••••••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-signin">Reset password →</button>

            </form>

            <hr class="divider" />
            <a asp-controller="Admin" asp-action="ForgotPassword" class="return-link">← Request a new code</a>

        </div>

    </div>

</body>
</html>
