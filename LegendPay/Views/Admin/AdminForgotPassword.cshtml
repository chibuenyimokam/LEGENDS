@model LegendPay.Models.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — LegendPay Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Sora:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Admin/AdminLogin.css" />
</head>
<body>

    <div class="admin-page">

        <div class="admin-brand">
            <div class="admin-brand-top">
                <img src="/screenicon/Background.svg" alt="LegendPay Logo" class="brand-img" />
                <span class="admin-brand-name">LegendPay</span>
            </div>
            <p class="admin-brand-label">Admin Portal</p>
        </div>

        <div class="admin-card">

            <h2 class="card-title">Forgot password</h2>
            <p class="card-subtitle">Enter your admin email and we'll send you a 6-digit code to reset your password.</p>

            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <form asp-action="ForgotPassword" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Email address</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                <polyline points="22,6 12,13 2,6" />
                            </svg>
                        </span>
                        <input asp-for="Email" class="form-input" placeholder="admin@legendpay.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button type="submit" class="btn-signin">Send reset code →</button>

            </form>

            <hr class="divider" />
            <a asp-controller="Admin" asp-action="Login" class="return-link">← Back to Admin Login</a>

        </div>

    </div>

</body>
</html>
