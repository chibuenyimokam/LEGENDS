@using LegendPay.Helpers
@model LegendPay.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Monitoring";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-7xl">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Monitoring</h2>
        <p class="text-sm text-on-surface-variant mt-0.5">Live overview of platform activity and transactions.</p>
    </div>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-surface border border-slate-200 p-6 rounded-xl">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Total Users</span>
                <span class="material-symbols-outlined text-primary text-lg">group</span>
            </div>
            <p class="text-2xl font-bold text-slate-900">@Model.TotalUsers.ToString("N0")</p>
            <p class="text-[11px] text-on-surface-variant mt-1">@Model.VerifiedUsers.ToString("N0") verified</p>
        </div>

        <div class="bg-surface border border-slate-200 p-6 rounded-xl">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Transactions Today</span>
                <span class="material-symbols-outlined text-primary text-lg">bolt</span>
            </div>
            <p class="text-2xl font-bold text-slate-900">@Model.TransactionsToday.ToString("N0")</p>
            <p class="text-[11px] text-on-surface-variant mt-1">Since midnight (UTC)</p>
        </div>

        <div class="bg-surface border border-slate-200 p-6 rounded-xl">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Value Today</span>
                <span class="material-symbols-outlined text-primary text-lg">account_balance_wallet</span>
            </div>
            <p class="text-2xl font-bold text-slate-900">₦@Model.TotalValueToday.ToString("N2")</p>
            <p class="text-[11px] text-on-surface-variant mt-1">Successful settlements</p>
        </div>

        <div class="bg-surface border border-slate-200 p-6 rounded-xl @(Model.FailedToday > 0 ? "border-l-4 border-l-red-500" : "")">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Failed Today</span>
                <span class="material-symbols-outlined @(Model.FailedToday > 0 ? "text-red-600" : "text-on-surface-variant") text-lg">report</span>
            </div>
            <p class="text-2xl font-bold text-slate-900">@Model.FailedToday.ToString("N0")</p>
            <p class="text-[11px] @(Model.FailedToday > 0 ? "text-red-600 font-semibold" : "text-on-surface-variant") mt-1">@(Model.FailedToday > 0 ? "Action may be required" : "No failures")</p>
        </div>
    </section>

    <section class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">Recent Transactions</h3>
            <a href="#" class="text-xs text-primary font-bold hover:underline">View all</a>
        </div>
        <div class="bg-surface border border-slate-200 rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Reference</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">User</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Biller</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest text-right">Amount</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Status</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-on-surface-variant uppercase tracking-widest">Time</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (Model.RecentTransactions.Any())
                        {
                            @foreach (var txn in Model.RecentTransactions)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-6 py-4 font-mono text-sm text-primary font-semibold">@txn.Reference</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-slate-900">@txn.UserName</td>
                                    <td class="px-6 py-4 text-sm text-on-surface-variant">@txn.BillerName</td>
                                    <td class="px-6 py-4 text-right font-bold text-sm text-slate-900">₦@txn.Amount.ToString("N2")</td>
                                    <td class="px-6 py-4">
                                        @if (txn.IsSuccess)
                                        {
                                            <span class="px-2.5 py-1 bg-green-100 text-green-700 text-[11px] font-bold rounded uppercase tracking-wider border border-green-200">Success</span>
                                        }
                                        else if (txn.IsPending)
                                        {
                                            <span class="px-2.5 py-1 bg-amber-100 text-amber-700 text-[11px] font-bold rounded uppercase tracking-wider border border-amber-200">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 bg-red-100 text-red-700 text-[11px] font-bold rounded uppercase tracking-wider border border-red-200">@txn.Status</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-xs text-on-surface-variant">@WatTime.FromUtc(txn.CreatedAt).ToString("MMM d, h:mm tt")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="px-6 py-12 text-center text-sm text-on-surface-variant" colspan="6">No transactions recorded yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
