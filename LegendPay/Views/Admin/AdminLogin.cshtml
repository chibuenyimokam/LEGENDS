@model LegendPay.Models.ViewModels.AdminLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LegendPay – Admin Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/AdminLogin.css" />
</head>
<body>

    <div class="wrapper">

        <!-- Brand -->
        <div class="brand">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="#2FD9A4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                </svg>
            </div>
            <span class="brand-name">LegendPay</span>
            <span class="brand-sub">Admin Portal</span>
        </div>

        <!-- Card -->
        <div class="card">
            <h1 class="card-title">Login</h1>
            <p class="card-sub">Welcome back, Administrator. Please sign in to continue.</p>

            <!-- Alerts -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-error show">@ViewBag.ErrorMessage</div>
            }
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success show">@ViewBag.SuccessMessage</div>
            }

            <!-- Step 1: Email + Password -->
            <form id="loginForm" asp-action="Login" asp-controller="AdminLogin" method="post">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label>Email address</label>
                    <div class="field-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="M2 7l10 7 10-7" />
                        </svg>
                        <input asp-for="Email" type="email" placeholder="admin@legendpay.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="hint" style="color:#E53E3E"></span>
                </div>

                <div class="field">
                    <div class="field-meta">
                        <label>Password</label>
                        <a href="#" class="forgot">Forgot Password?</a>
                    </div>
                    <div class="field-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0110 0v4" />
                        </svg>
                        <input asp-for="Password" id="passwordInput" type="password" placeholder="••••••••••••" autocomplete="current-password" />
                        <button type="button" class="toggle-pw" onclick="togglePassword()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="hint" style="color:#E53E3E"></span>
                </div>

                <!-- Step 2: 2FA (shown after login succeeds) -->
                <div class="otp-section @(ViewBag.ShowOtp == true ? "show" : "")" id="otpSection">
                    <div class="otp-divider"><span>2FA Verification</span></div>
                    <div class="field">
                        <label>2FA Code</label>
                        <div class="field-row">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                            <input type="text" id="otpInput" name="twoFactorCode" placeholder="000 000" maxlength="6" autocomplete="one-time-code" />
                            <svg viewBox="0 0 24 24" fill="none" stroke="#2FD9A4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </div>
                        <p class="hint">Enter the 6-digit code sent to your email.</p>
                    </div>
                    <input type="hidden" name="email" value="@ViewBag.AdminEmail" />
                </div>

                <button type="submit" class="btn-primary" id="submitBtn" onclick="handleSubmit(event)">
                    <div class="spinner"></div>
                    <span class="btn-text">Sign In →</span>
                </button>
            </form>

            <div class="card-footer">
                <a href="/">← Return to User Portal</a>
            </div>
        </div>

        <!-- Security badge -->
        <div class="secure-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            Secure encrypted connection established.
        </div>

        <div class="sys-info">
            System Version: v2.0.42-stable<br />
            Last System Update: 01 Jun 2026, 14:32 WAT
        </div>

    </div>

    <!-- Pass Razor values to JS -->
    <script>
        const otpVisible = @(ViewBag.ShowOtp == true ? "true" : "false");
        const verifyOtpUrl = '@Url.Action("VerifyOtp", "AdminLogin")';
    </script>
    <script src="~/js/AdminLogin.js"></script>

</body>
</html>
