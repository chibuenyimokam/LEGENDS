@using LegendPay.Helpers
@model LegendPay.Models.ViewModels.AdminSupportChatDetailViewModel
@{
    ViewData["Title"] = "Dispute";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var statuses = new[] { "Open", "InProgress", "Resolved", "Closed" };
    var name = Model.Chat.UserAccount != null ? $"{Model.Chat.UserAccount.FirstName} {Model.Chat.UserAccount.LastName}" : "Unknown";

    string BadgeClass(string status) => status switch
    {
        "Open" => "bg-amber-50 text-amber-700 ring-amber-600/20",
        "InProgress" => "bg-blue-50 text-blue-700 ring-blue-600/20",
        "Resolved" => "bg-green-50 text-green-700 ring-green-600/20",
        "Closed" => "bg-slate-100 text-slate-600 ring-slate-500/20",
        _ => "bg-slate-100 text-slate-600 ring-slate-500/20"
    };
}

<div class="flex-1 px-10 py-8 max-w-4xl w-full mx-auto">

    <a asp-action="UserSupport" class="inline-flex items-center gap-1 text-sm text-on-surface-variant hover:text-slate-900 mb-5">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Back to disputes
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">@TempData["ErrorMessage"]</div>
    }

    <div class="bg-surface border border-slate-200 rounded-xl overflow-hidden">

        <div class="flex items-start justify-between gap-4 px-6 py-5 border-b border-slate-200">
            <div>
                <h2 class="text-lg font-bold text-slate-900">@Model.Chat.Subject</h2>
                <p class="text-sm text-on-surface-variant mt-0.5">@name • @Model.Chat.UserAccount?.Email</p>
                <p class="text-xs text-on-surface-variant/70 mt-1">Opened @WatTime.FromUtc(Model.Chat.CreatedAt).ToString("dd MMM yyyy, HH:mm") WAT</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold ring-1 ring-inset @BadgeClass(Model.Chat.Status)">@Model.Chat.Status</span>
                <form asp-action="UpdateStatus" method="post" class="flex items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="chatId" value="@Model.Chat.Id" />
                    <select name="newStatus" class="text-xs border border-slate-200 rounded-md py-1.5 pl-2 pr-6 bg-white focus:ring-1 focus:ring-primary">
                        @foreach (var s in statuses)
                        {
                            if (s == Model.Chat.Status)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                    <button type="submit" class="text-xs font-semibold text-primary hover:underline">Update</button>
                </form>
            </div>
        </div>

        <div class="px-6 py-6 space-y-4 bg-slate-50/40 max-h-[28rem] overflow-y-auto" id="messageThread">
            @if (!Model.Messages.Any())
            {
                <p class="text-center text-sm text-on-surface-variant py-8">No messages in this conversation yet.</p>
            }
            else
            {
                foreach (var msg in Model.Messages)
                {
                    var isAdmin = msg.Sender == "Admin";
                    <div class="flex @(isAdmin ? "justify-end" : "justify-start")">
                        <div class="max-w-[75%]">
                            <div class="@(isAdmin ? "bg-primary text-white" : "bg-white border border-slate-200 text-slate-800") rounded-xl px-4 py-2.5 text-sm shadow-sm">
                                @msg.MessageText
                            </div>
                            <p class="text-[11px] text-on-surface-variant/70 mt-1 @(isAdmin ? "text-right" : "text-left")">
                                @(isAdmin ? "You" : name) • @WatTime.FromUtc(msg.CreatedAt).ToString("dd MMM, HH:mm")
                            </p>
                        </div>
                    </div>
                }
            }
        </div>

        <form asp-action="SendReply" method="post" class="flex items-end gap-3 px-6 py-4 border-t border-slate-200">
            @Html.AntiForgeryToken()
            <input type="hidden" name="chatId" value="@Model.Chat.Id" />
            <textarea name="replyText" rows="2" required placeholder="Type your reply…"
                      class="flex-1 resize-none border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-1 focus:ring-primary focus:border-primary"></textarea>
            <button type="submit" class="bg-primary text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-primary-container transition-colors flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[18px]">send</span>
                Send
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var t = document.getElementById('messageThread');
            if (t) t.scrollTop = t.scrollHeight;
        })();
    </script>
}
