@using LegendPay.Helpers
@model LegendPay.Models.ViewModels.AdminSupportInboxViewModel
@{
    ViewData["Title"] = "Disputes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var statuses = new[] { "Open", "InProgress", "Resolved", "Closed" };

    string BadgeClass(string status) => status switch
    {
        "Open" => "bg-amber-50 text-amber-700 ring-amber-600/20",
        "InProgress" => "bg-blue-50 text-blue-700 ring-blue-600/20",
        "Resolved" => "bg-green-50 text-green-700 ring-green-600/20",
        "Closed" => "bg-slate-100 text-slate-600 ring-slate-500/20",
        _ => "bg-slate-100 text-slate-600 ring-slate-500/20"
    };
}

<div class="flex-1 px-10 py-8">

    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-2xl font-bold text-slate-900">Disputes &amp; Support</h2>
            <p class="text-sm text-on-surface-variant mt-1">Review and respond to customer complaints and support requests.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null || Model.ErrorMessage != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">@(TempData["ErrorMessage"] ?? Model.ErrorMessage)</div>
    }

    <div class="flex items-center gap-2 mb-5">
        <a asp-action="UserSupport"
           class="px-3 py-1.5 rounded-full text-xs font-semibold transition-colors @(string.IsNullOrEmpty(Model.ActiveStatusFilter) ? "bg-primary text-white" : "bg-slate-100 text-on-surface-variant hover:bg-slate-200")">
            All
        </a>
        @foreach (var s in statuses)
        {
            <a asp-action="UserSupport" asp-route-status="@s"
               class="px-3 py-1.5 rounded-full text-xs font-semibold transition-colors @(Model.ActiveStatusFilter == s ? "bg-primary text-white" : "bg-slate-100 text-on-surface-variant hover:bg-slate-200")">
                @s
            </a>
        }
    </div>

    <div class="bg-surface border border-slate-200 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-on-surface-variant bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-3 font-semibold">Subject</th>
                    <th class="px-6 py-3 font-semibold">Customer</th>
                    <th class="px-6 py-3 font-semibold text-center">Messages</th>
                    <th class="px-6 py-3 font-semibold">Status</th>
                    <th class="px-6 py-3 font-semibold">Last Activity</th>
                    <th class="px-6 py-3 font-semibold text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (!Model.Chats.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-16 text-center">
                            <span class="material-symbols-outlined text-[40px] text-slate-300">forum</span>
                            <p class="text-sm text-on-surface-variant mt-2">No disputes @(string.IsNullOrEmpty(Model.ActiveStatusFilter) ? "" : $"with status \"{Model.ActiveStatusFilter}\"") yet.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var chat in Model.Chats)
                    {
                        var name = chat.UserAccount != null ? $"{chat.UserAccount.FirstName} {chat.UserAccount.LastName}" : "Unknown";
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-900 max-w-xs truncate">@chat.Subject</td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-800">@name</div>
                                <div class="text-xs text-on-surface-variant">@chat.UserAccount?.Email</div>
                            </td>
                            <td class="px-6 py-4 text-center text-on-surface-variant">@(chat.Messages?.Count ?? 0)</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold ring-1 ring-inset @BadgeClass(chat.Status)">@chat.Status</span>
                            </td>
                            <td class="px-6 py-4 text-on-surface-variant whitespace-nowrap">@WatTime.FromUtc(chat.UpdatedAt).ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="px-6 py-4 text-right">
                                <a asp-action="AdminSupport" asp-route-chatId="@chat.Id"
                                   class="inline-flex items-center gap-1 text-primary font-semibold hover:underline">
                                    Open
                                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
