@model LegendPay.Models.ViewModels.UserDashboard.WalletDashboardViewModel
@{
    ViewData["Title"] = "Fund Wallet";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var hasAccountNumber = !string.IsNullOrWhiteSpace(Model.AccountNumber);
}
@functions {
    private static string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;

        if (span.TotalSeconds < 60) return "Just now";
        if (span.TotalMinutes < 60)
        {
            var mins = (int)span.TotalMinutes;
            return $"{mins} min{(mins == 1 ? "" : "s")} ago";
        }
        if (span.TotalHours < 24)
        {
            var hours = (int)span.TotalHours;
            return $"{hours} hour{(hours == 1 ? "" : "s")} ago";
        }
        if (span.TotalDays < 7)
        {
            var days = (int)span.TotalDays;
            return $"{days} day{(days == 1 ? "" : "s")} ago";
        }

        return utc.ToLocalTime().ToString("MMM d, yyyy");
    }
}

<div class="p-6 md:p-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8 space-y-8">
            <section class="bg-surface-container-lowest p-8 rounded-2xl tonal-elevation border border-surface-variant relative overflow-hidden">
                @if (!string.IsNullOrWhiteSpace(Model.WeeklyChangeLabel))
                {
                    <div class="absolute right-0 top-0 p-4">
                        <div class="bg-naira-green/10 text-naira-green px-3 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5">
                            <span class="material-symbols-outlined scale-75" data-icon="trending_up">trending_up</span>
                            @Model.WeeklyChangeLabel
                        </div>
                    </div>
                }
                <div class="space-y-1">
                    <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Current Wallet Balance</p>
                    <div class="flex items-center gap-3">
                        <h2 id="walletBalance" data-amount="&#8358;@Model.Balance.ToString("N2")" class="font-display-lg text-display-lg text-on-surface">&#8358;@Model.Balance.ToString("N2")</h2>
                        <button id="balanceToggle" type="button" class="material-symbols-outlined text-on-surface-variant/60 hover:text-primary transition-colors cursor-pointer p-1 rounded-full hover:bg-surface-container-low" aria-label="Toggle balance visibility">
                            visibility
                        </button>
                    </div>
                </div>
                <div class="mt-8 flex flex-wrap gap-3">
                    <button class="bg-primary text-on-primary px-8 py-3 rounded-lg font-label-md text-label-md flex items-center gap-2 hover:shadow-lg transition-all active:scale-[0.98]">
                        <span class="material-symbols-outlined" data-icon="add_circle">add_circle</span>
                        Add Funds
                    </button>
                </div>
            </section>

            <section class="space-y-4">
                <h3 class="font-label-md text-label-md text-on-surface-variant px-1">Funding Method</h3>
                <div class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6 hover:border-primary/30 transition-colors group">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 bg-primary-container text-primary rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined text-3xl" data-icon="account_balance">account_balance</span>
                            </div>
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <h4 class="font-headline-md text-headline-md !text-lg text-on-surface">Bank Transfer</h4>
                                    <span class="px-2 py-0.5 bg-naira-green/10 text-naira-green text-[10px] font-bold rounded uppercase tracking-tighter">Instant</span>
                                </div>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">@(string.IsNullOrWhiteSpace(Model.BankName) ? "Awaiting bank assignment" : Model.BankName)</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 bg-surface-container-low p-3 md:p-4 rounded-lg border border-surface-variant">
                            <div>
                                <p class="text-[10px] text-on-surface-variant uppercase font-bold mb-0.5">Account Number</p>
                                <p class="text-2xl font-black text-on-surface tracking-tight" id="accountNumber">@(hasAccountNumber ? Model.AccountNumberFormatted : "Pending activation")</p>
                            </div>
                            @if (hasAccountNumber)
                            {
                                <button class="bg-primary text-white p-2.5 rounded-lg hover:brightness-125 transition-all flex items-center justify-center" onclick="copyToClipboard('@Model.AccountNumber')">
                                    <span class="material-symbols-outlined" data-icon="content_copy">content_copy</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-surface-variant/50 flex items-start gap-2 text-on-surface-variant/70">
                        <span class="material-symbols-outlined text-sm mt-0.5" data-icon="info">info</span>
                        <p class="text-xs">Transfer from any bank app. Your wallet is credited automatically in seconds.</p>
                    </div>
                </div>
            </section>

            <section class="space-y-4">
                <div class="flex items-center justify-between px-1">
                    <h3 class="font-label-md text-label-md text-on-surface-variant">Recent Activity</h3>
                    <button class="text-primary font-label-sm text-label-sm hover:underline">View History</button>
                </div>
                <div class="bg-surface-container-lowest border border-surface-variant rounded-xl divide-y divide-surface-variant">
                    @if (Model.RecentTransactions.Any())
                    {
                        @foreach (var txn in Model.RecentTransactions)
                        {
                            <div class="p-5 flex items-center justify-between group hover:bg-surface-container-low transition-colors">
                                <div class="flex items-center gap-4">
                                    @if (txn.IsPending)
                                    {
                                        <div class="w-11 h-11 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                    }
                                    else if (txn.IsCredit)
                                    {
                                        <div class="w-11 h-11 bg-naira-green/10 text-naira-green rounded-full flex items-center justify-center">
                                            <span class="material-symbols-outlined" data-icon="add" style="font-variation-settings: 'wght' 700;">add</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-11 h-11 bg-error/10 text-error rounded-full flex items-center justify-center">
                                            <span class="material-symbols-outlined" data-icon="arrow_outward" style="font-variation-settings: 'wght' 700;">arrow_outward</span>
                                        </div>
                                    }
                                    <div>
                                        <p class="font-label-md text-label-md text-on-surface">@txn.Description</p>
                                        <p class="text-xs text-on-surface-variant">@(txn.IsPending ? "Scanning bank incoming network" : (string.IsNullOrWhiteSpace(Model.BankName) ? "Bank Transfer" : $"Via {Model.BankName}"))</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    @if (txn.IsPending)
                                    {
                                        <p class="text-xs font-medium text-on-surface-variant">@txn.Status</p>
                                    }
                                    else
                                    {
                                        <p class="font-bold @(txn.IsCredit ? "text-naira-green" : "text-error")">@(txn.IsCredit ? "+" : "-")&#8358;@txn.Amount.ToString("N2")</p>
                                    }
                                    <p class="text-[10px] text-on-surface-variant/60">@RelativeTime(txn.Date)</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-10 flex flex-col items-center justify-center text-center gap-2">
                            <span class="material-symbols-outlined text-on-surface-variant/40 text-4xl" data-icon="receipt_long">receipt_long</span>
                            <p class="font-label-md text-label-md text-on-surface">No activity yet</p>
                            <p class="text-xs text-on-surface-variant">Your wallet funding history will appear here.</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside class="lg:col-span-4 space-y-8">
            <div class="relative p-6 rounded-2xl bg-primary text-on-primary overflow-hidden h-44 flex flex-col justify-end group cursor-pointer shadow-lg shadow-primary/20">
                <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/40 to-transparent"></div>
                <div class="relative z-10 space-y-1">
                    <p class="text-[10px] uppercase font-black tracking-widest text-primary-fixed">Loyalty Offer</p>
                    <h4 class="text-xl font-extrabold leading-tight">Fund &#8358;50k+ and get <br />instant cashback</h4>
                </div>
            </div>

            <div class="bg-surface-container-low p-6 rounded-2xl border border-surface-variant/50">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm">
                        <span class="material-symbols-outlined text-primary" data-icon="verified_user" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                    </div>
                    <h4 class="font-label-md text-label-md font-bold">Secure Infrastructure</h4>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    LegendPay employs bank-grade security protocols and NDPR compliance to ensure every kobo is accounted for.
                </p>
            </div>

            <div class="space-y-4">
                <h4 class="font-label-md text-label-md text-on-surface-variant px-1">Common Questions</h4>
                <div class="bg-surface-container-lowest rounded-xl border border-surface-variant overflow-hidden">
                    <details class="group">
                        <summary class="flex items-center justify-between cursor-pointer p-4 font-label-md text-label-md list-none group-open:bg-surface-container-low transition-colors">
                            Funding duration?
                            <span class="material-symbols-outlined group-open:rotate-180 transition-transform" data-icon="expand_more">expand_more</span>
                        </summary>
                        <div class="p-4 pt-0 text-sm text-on-surface-variant bg-surface-container-low">
                            Transfers are typically credited within 60 seconds of successful processing by your bank.
                        </div>
                    </details>
                    <details class="group border-t border-surface-variant">
                        <summary class="flex items-center justify-between cursor-pointer p-4 font-label-md text-label-md list-none group-open:bg-surface-container-low transition-colors">
                            Are there fees?
                            <span class="material-symbols-outlined group-open:rotate-180 transition-transform" data-icon="expand_more">expand_more</span>
                        </summary>
                        <div class="p-4 pt-0 text-sm text-on-surface-variant bg-surface-container-low">
                            LegendPay does not charge fees for wallet funding via bank transfer.
                        </div>
                    </details>
                    <details class="group border-t border-surface-variant">
                        <summary class="flex items-center justify-between cursor-pointer p-4 font-label-md text-label-md list-none group-open:bg-surface-container-low transition-colors">
                            Transfer limits?
                            <span class="material-symbols-outlined group-open:rotate-180 transition-transform" data-icon="expand_more">expand_more</span>
                        </summary>
                        <div class="p-4 pt-0 text-sm text-on-surface-variant bg-surface-container-low">
                            Daily limits depend on your KYC level@(string.IsNullOrEmpty(Model.KycTier) ? "" : $" ({Model.KycTier})").
                        </div>
                    </details>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const balance = document.getElementById('walletBalance');
            const toggle = document.getElementById('balanceToggle');

            if (balance && toggle) {
                let masked = false;
                toggle.addEventListener('click', () => {
                    masked = !masked;
                    balance.textContent = masked ? '₦••••••' : balance.dataset.amount;
                    toggle.textContent = masked ? 'visibility_off' : 'visibility';
                });
            }

            document.querySelectorAll('details').forEach((el) => {
                el.addEventListener('toggle', () => {
                    if (el.open) {
                        document.querySelectorAll('details').forEach((other) => {
                            if (other !== el) other.removeAttribute('open');
                        });
                    }
                });
            });
        })();
    </script>
}
