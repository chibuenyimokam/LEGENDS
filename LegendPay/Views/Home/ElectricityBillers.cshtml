@model LegendPay.Models.ViewModels.UserDashboard.PayBillsViewModel
@{
    ViewData["Title"] = "Electricity – Select Provider";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var billers = new[]
    {
        new { Name = "Ikeja Electric",          ShortName = "IKEDC", Icon = "bolt", Region = "Lagos Mainland" },
        new { Name = "Eko Electric",            ShortName = "EKEDC", Icon = "bolt", Region = "Lagos Island"   },
        new { Name = "Abuja Electric",          ShortName = "AEDC",  Icon = "bolt", Region = "Abuja"          },
        new { Name = "Ibadan Electric",         ShortName = "IBEDC", Icon = "bolt", Region = "Ibadan"         },
        new { Name = "Enugu Electric",          ShortName = "EEDC",  Icon = "bolt", Region = "Enugu"          },
        new { Name = "Port Harcourt Electric",  ShortName = "PHEDC", Icon = "bolt", Region = "Port Harcourt"  },
        new { Name = "Kaduna Electric",         ShortName = "KAEDCO",Icon = "bolt", Region = "Kaduna"         },
        new { Name = "Jos Electric",            ShortName = "JEDC",  Icon = "bolt", Region = "Jos"            },
        new { Name = "Benin Electric",          ShortName = "BEDC",  Icon = "bolt", Region = "Benin City"     },
        new { Name = "Yola Electric",           ShortName = "YEDC",  Icon = "bolt", Region = "Yola"           },
        new { Name = "Kano Electric",           ShortName = "KEDCO", Icon = "bolt", Region = "Kano"           },
    };
}

<div class="p-10 space-y-8 max-w-4xl">

    <!-- Page heading -->
    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">Electricity Bill</h2>
        <p class="text-sm text-on-surface-variant mt-1">Select your electricity provider to continue.</p>
    </div>

    <!-- 4-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">

            <!-- Step 1 — active -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</div>
                <span class="text-xs font-semibold text-primary">Select Biller</span>
            </div>

            <div class="flex-1 h-px bg-slate-200 mx-2"></div>

            <!-- Step 2 -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-xs font-medium text-on-surface-variant">Enter Details</span>
            </div>

            <div class="flex-1 h-px bg-slate-200 mx-2"></div>

            <!-- Step 3 -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>

            <div class="flex-1 h-px bg-slate-200 mx-2"></div>

            <!-- Step 4 -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">4</div>
                <span class="text-xs font-medium text-on-surface-variant">Done</span>
            </div>

        </div>
    </div>

    <!-- Biller grid -->
    <div class="space-y-4">
        <h3 class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Select Provider</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            @foreach (var biller in billers)
            {
                <a href="@Url.Action("ElectricityDetails", "Home", new { billerName = biller.ShortName, billerFullName = biller.Name })"
                       class="bg-surface border border-slate-200 rounded-xl p-6 flex flex-col items-center justify-center gap-3 text-center hover:border-primary hover:shadow-md transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">@biller.Icon</span>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-on-surface">@biller.ShortName</p>
                        <p class="text-xs text-on-surface-variant mt-0.5">@biller.Region</p>
                    </div>
                </a>
            }
        </div>
    </div>

</div>
