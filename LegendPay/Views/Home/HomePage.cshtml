@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LegendPay — Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-name">User Central</span>
            <span class="brand-sub">Management Portal</span>
        </div>

        <nav class="sidebar-nav">
            <a href="#" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                Overview
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" /><rect x="9" y="3" width="6" height="4" rx="1" /></svg>
                Transactions
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                Analytics
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                Support
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="account-status">
                <span class="status-dot"></span>
                Account Status: Active
            </div>
            <a href="#" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                Settings
            </a>
            <a asp-controller="Accounts" asp-action="Logout" class="sidebar-link logout-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Logout
            </a>
        </div>
    </aside>

    <main class="main">
        <div class="topbar">
            <div class="topbar-left">
                <h1 class="greeting">Welcome back, @(((string)ViewBag.FullName ?? "").Split(' ')[0])</h1>
                <p class="greeting-sub">Here's what's happening with your account today.</p>
            </div>
            <div class="topbar-right">
                <button class="btn btn-outline" id="btn-statement">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Statement
                </button>
                <button class="btn btn-primary" id="btn-topup">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Top Up
                </button>
            </div>
        </div>

        <div class="content-grid">
            <div class="col-left">
                <div class="balance-card">
                    <div class="balance-top">
                        <div class="balance-left">
                            <span class="balance-label">AVAILABLE BALANCE</span>
                            <div class="balance-figure">
                                @if (ViewBag.Balance != null && ViewBag.Balance != "Unavailable")
                                {
                                    <span class="balance-main" id="balance-animated">&#8358;@ViewBag.Balance</span>
                                }
                                else
                                {
                                    <span class="balance-main balance-na">—</span>
                                }
                            </div>
                        </div>
                        <div class="wallet-id-pill" id="wallet-id-pill">
                            <div class="wid-inner">
                                <span class="wid-label">WALLET ID</span>
                                <span class="wid-value" id="wid-text">@(ViewBag.WalletId ?? "—")</span>
                            </div>
                            <button class="copy-btn" id="copy-wid" title="Copy wallet ID">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" /></svg>
                            </button>
                        </div>
                    </div>
                    <div class="balance-actions">
                        <button class="balance-btn balance-btn--light" id="btn-fund">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                            Fund Wallet
                        </button>
                        <button class="balance-btn balance-btn--dark" id="btn-paybill">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                            Pay Bill
                        </button>
                    </div>
                </div>

                <div class="quick-actions">
                    <div class="qa-item" id="qa-paybill">
                        <div class="qa-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" /><rect x="9" y="3" width="6" height="4" rx="1" /></svg>
                        </div>
                        <span>Pay Bill</span>
                    </div>
                    <div class="qa-item" id="qa-airtime">
                        <div class="qa-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg>
                        </div>
                        <span>Buy Airtime</span>
                    </div>
                    <div class="qa-item" id="qa-fund">
                        <div class="qa-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
                        </div>
                        <span>Fund Wallet</span>
                    </div>
                    <div class="qa-item" id="qa-rewards">
                        <div class="qa-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                        </div>
                        <span>Rewards</span>
                    </div>
                </div>

                <div class="section-card">
                    <div class="section-header">
                        <h2>Upcoming Renewals</h2>
                        <a href="#" class="link-blue">See All</a>
                    </div>
                    <div class="renewals-row">
                        <div class="renewal-item">
                            <div class="renewal-icon-wrap renewal-amber">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                            </div>
                            <div class="renewal-body">
                                <span class="renewal-badge badge-amber">DUE IN 2 DAYS</span>
                                <div class="renewal-name">Electricity (EKEDC)</div>
                                <div class="renewal-meta">Meter: 4509122340</div>
                                <div class="renewal-footer">
                                    <span class="renewal-amount">₦12,500</span>
                                    <button class="btn btn-sm btn-outline">Pay Now</button>
                                </div>
                            </div>
                        </div>
                        <div class="renewal-item">
                            <div class="renewal-icon-wrap renewal-blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0114.08 0" /><path d="M1.42 9a16 16 0 0121.16 0" /><path d="M8.53 16.11a6 6 0 016.95 0" /><line x1="12" y1="20" x2="12.01" y2="20" /></svg>
                            </div>
                            <div class="renewal-body">
                                <span class="renewal-badge badge-grey">DUE IN 5 DAYS</span>
                                <div class="renewal-name">MTN Fiber Internet</div>
                                <div class="renewal-meta">Plan: Unlimited 50Mbps</div>
                                <div class="renewal-footer">
                                    <span class="renewal-amount">₦25,000</span>
                                    <button class="btn btn-sm btn-ghost">Auto-Pay</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="col-right">
                <div class="section-card">
                    <div class="points-header">
                        <div class="points-star">
                            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                        </div>
                        <span class="points-title">Legend Points</span>
                    </div>
                    <div class="points-row">
                        <span class="points-val">2,450</span>
                        <span class="points-goal">Goal: 5,000</span>
                    </div>
                    <div class="points-track">
                        <div class="points-fill" data-progress="49%"></div>
                    </div>
                    <p class="points-hint">You're ₦500 away from your next cashback reward!</p>
                    <button class="btn btn-outline btn-block">Redeem Points</button>
                </div>

                <div class="section-card">
                    <div class="section-header">
                        <h2>Recent Activity</h2>
                        <a href="#" class="link-blue">History</a>
                    </div>
                    <ul class="activity-list">
                        <li class="activity-item">
                            <div class="act-icon act-green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                            </div>
                            <div class="act-info">
                                <span class="act-name">Bank Transfer</span>
                                <span class="act-date">Today, 10:45 AM</span>
                            </div>
                            <span class="act-amount credit">+₦50,000</span>
                        </li>
                        <li class="activity-item">
                            <div class="act-icon act-red">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" /></svg>
                            </div>
                            <div class="act-info">
                                <span class="act-name">Verge Superstore</span>
                                <span class="act-date">Yesterday, 8:20 PM</span>
                            </div>
                            <span class="act-amount debit">-₦18,400</span>
                        </li>
                        <li class="activity-item">
                            <div class="act-icon act-amber">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                            </div>
                            <div class="act-info">
                                <span class="act-name">EKEDC Utility</span>
                                <span class="act-date">Aug 24, 2:15 PM</span>
                            </div>
                            <span class="act-amount debit">-₦10,000</span>
                        </li>
                        <li class="activity-item">
                            <div class="act-icon act-blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" /></svg>
                            </div>
                            <div class="act-info">
                                <span class="act-name">MTN Airtime</span>
                                <span class="act-date">Aug 23, 11:00 AM</span>
                            </div>
                            <span class="act-amount debit">-₦5,000</span>
                        </li>
                        <li class="activity-item">
                            <div class="act-icon act-green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                            </div>
                            <div class="act-info">
                                <span class="act-name">Wallet Fund</span>
                                <span class="act-date">Aug 22, 9:30 AM</span>
                            </div>
                            <span class="act-amount credit">+₦100,000</span>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </main>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>