@using LegendPay.Models.ViewModels
@model LegendPay.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LegendPay – User Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/UserDashboard.css" />
</head>
<body>

    <!-- ── SIDEBAR ── -->
    <aside class="sidebar" id="sidebar">
        <button class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>

        <div class="sidebar-brand">
            <h2 class="brand-text">User Central</h2>
            <p class="brand-sub">Management Portal</p>
        </div>

        <nav class="sidebar-nav">
            <a class="nav-item active" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                <span class="nav-label">Overview</span>
            </a>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                <span class="nav-label">Transactions</span>
            </a>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                <span class="nav-label">Analytics</span>
            </a>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                <span class="nav-label">Support</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="status-badge">
                <div class="status-dot"></div>
                <span class="brand-text">Account Status: Active</span>
            </div>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                <span class="nav-label">Settings</span>
            </a>
            <a class="nav-item" href="/Accounts/Logout" style="color:#EF4444;">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                <span class="nav-label">Logout</span>
            </a>
        </div>
    </aside>

    <!-- ── MAIN CONTENT ── -->
    <main class="main" id="main-content">
        <div class="content">

            <!-- LEFT COLUMN -->
            <div class="left-col">

                <!-- Page Header -->
                <div class="page-header">
                    <div>
                        <h1>Welcome back, <span>@Model.AccountInfo.UserName</span></h1>
                        <p>Here's what's happening with your account today.</p>
                    </div>
                    <div class="header-actions">
                        <button class="btn btn-outline">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
                            Statement
                        </button>
                        <button class="btn btn-primary">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                            Top Up
                        </button>
                    </div>
                </div>

                <!-- Balance Card -->
                <div class="balance-card">
                    <div class="balance-top">
                        <div class="balance-label">Available Balance</div>
                        <div class="wallet-chip">
                            <div>
                                <span class="wallet-chip-label">Wallet ID</span>
                                <span class="wallet-chip-id" id="wallet-id" data-full="@Model.AccountInfo.WalletId">
                                    @(Model.AccountInfo.WalletId?.Length > 12
                                      ? Model.AccountInfo.WalletId.Substring(0, 8) + "..." + Model.AccountInfo.WalletId.Substring(Model.AccountInfo.WalletId.Length - 2)
                                      : Model.AccountInfo.WalletId)
                                </span>
                            </div>
                            <button class="copy-btn" title="Copy wallet ID" onclick="copyWalletId()">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" /></svg>
                            </button>
                        </div>
                    </div>

                    <div class="balance-amount">
                        ₦<span id="balance-display">@Model.AccountInfo.AvailableBalance.ToString("N2")</span>
                    </div>

                    <div class="balance-actions">
                        <button class="balance-btn fund">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                            Fund Wallet
                        </button>
                        <button class="balance-btn pay">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" /><circle cx="12" cy="12" r="2" /></svg>
                            Pay Bill
                        </button>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="quick-actions">
                    <div class="action-card">
                        <div class="action-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <span>Pay Bill</span>
                    </div>
                    <div class="action-card">
                        <div class="action-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" /><line x1="12" y1="18" x2="12" y2="18" stroke-linecap="round" stroke-width="3" /></svg>
                        </div>
                        <span>Buy Airtime</span>
                    </div>
                    <div class="action-card">
                        <div class="action-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                        </div>
                        <span>Fund Wallet</span>
                    </div>
                    <div class="action-card">
                        <div class="action-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                        </div>
                        <span>Rewards</span>
                    </div>
                </div>

                <!-- Upcoming Renewals -->
                <div>
                    <div class="renewals-header">
                        <div class="section-title">Upcoming Renewals</div>
                        <a href="#" class="see-all">See All</a>
                    </div>
                    <div class="renewals-grid">
                        @if (Model.UpcomingRenewals != null && Model.UpcomingRenewals.Any())
                        {
                            @foreach (var renewal in Model.UpcomingRenewals)
                            {
                                string dueClass = renewal.DaysUntilDue <= 2 ? "due-urgent" : renewal.DaysUntilDue <= 5 ? "due-soon" : "due-normal";
                                string actionClass = renewal.IsAutoPay ? "btn-auto" : "btn-pay-now";
                                string actionText = renewal.IsAutoPay ? "Auto-Pay" : "Pay Now";
                                <div class="renewal-card">
                                    <div class="renewal-top">
                                        <div class="renewal-icon" style="background:#FFFBEB">⚡</div>
                                        <span class="due-badge @dueClass">DUE IN @renewal.DaysUntilDue DAYS</span>
                                    </div>
                                    <div class="renewal-name">@renewal.ServiceName</div>
                                    <div class="renewal-detail">@renewal.Detail</div>
                                    <div class="renewal-footer">
                                        <div class="renewal-amount">₦@renewal.Amount.ToString("N0")</div>
                                        <button class="renewal-action @actionClass">@actionText</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: var(--text-muted); font-size: 0.85rem;">No upcoming renewals.</p>
                        }
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="right-col">

                <!-- Legend Points -->
                <div class="card">
                    <div class="points-header">
                        <div class="points-star">★</div>
                        <h3>Legend Points</h3>
                    </div>
                    <div class="points-row">
                        <div class="points-value">@Model.LegendPoints.CurrentPoints.ToString("N0")</div>
                        <div class="points-goal">Goal: @Model.LegendPoints.GoalPoints.ToString("N0")</div>
                    </div>
                    <div class="progress-bar">
                        @{
                            double pct = Model.LegendPoints.GoalPoints > 0
                              ? Math.Min((double)Model.LegendPoints.CurrentPoints / Model.LegendPoints.GoalPoints * 100, 100)
                              : 0;
                        }
                        <div class="progress-fill" style="width: @pct.ToString("F0")%"></div>
                    </div>
                    <p class="points-hint">
                        @if (Model.LegendPoints.CurrentPoints >= Model.LegendPoints.GoalPoints)
                        {
                            <span>You've reached your goal! Redeem your points now.</span>
                        }
                        else
                        {
                            <span>You're ₦@Model.LegendPoints.AmountToNextReward.ToString("N0") away from your next cashback reward!</span>
                        }
                    </p>
                    <button class="btn-redeem">Redeem Points</button>
                </div>

                <!-- Recent Activity -->
                <div class="card">
                    <div class="activity-header">
                        <h3>Recent Activity</h3>
                        <a href="#" class="see-all">History</a>
                    </div>
                    <div class="activity-list">
                        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                        {
                            @foreach (var activity in Model.RecentActivities)
                            {
                                string amountClass = activity.IsCredit ? "amount-credit" : "amount-debit";
                                string amountPrefix = activity.IsCredit ? "+" : "-";
                                <div class="activity-item">
                                    <div class="activity-icon" style="background:@(activity.IsCredit ? "#DCFCE7" : "#FEF2F2"); color:@(activity.IsCredit ? "#16A34A" : "#DC2626")">
                                        @(activity.IsCredit ? "↑" : "↓")
                                    </div>
                                    <div class="activity-info">
                                        <div class="activity-name">@activity.Description</div>
                                        <div class="activity-time">@activity.Date.ToString("MMM dd, hh:mm tt")</div>
                                    </div>
                                    <div class="activity-amount @amountClass">@amountPrefix₦@activity.Amount.ToString("N0")</div>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: var(--text-muted); font-size: 0.85rem;">No recent activity.</p>
                        }
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script src="~/js/UserDashboard.js"></script>
</body>
</html>


