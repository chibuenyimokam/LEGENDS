@model LegendPay.Models.ViewModels.UserDashboard.InternetDetailsViewModel
@{
    ViewData["Title"] = "Purchase Data";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-4xl">

    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">Purchase Data</h2>
        <p class="text-sm text-on-surface-variant mt-1">Select your network, choose a plan and enter your phone number.</p>
    </div>

    <!-- 3-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</div>
                <span class="text-xs font-semibold text-primary">Enter Details</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-xs font-medium text-on-surface-variant">Done</span>
            </div>
        </div>
    </div>

    <!-- Main form card -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-8 space-y-6">

        <!-- Network selection -->
        <div class="space-y-3">
            <label class="text-sm font-semibold text-on-surface">Select Network Provider</label>
            <div class="grid grid-cols-4 gap-3">
                @foreach (var network in new[] {
                    new { Name = "MTN",     Color = "bg-yellow-400", TextColor = "text-yellow-900" },
                    new { Name = "Airtel",  Color = "bg-red-500",    TextColor = "text-white"      },
                    new { Name = "Glo",     Color = "bg-green-500",  TextColor = "text-white"      },
                    new { Name = "9mobile", Color = "bg-green-700",  TextColor = "text-yellow-300" },
                })
                {
                    <button type="button"
                            onclick="selectNetwork('@network.Name')"
                            id="network-@network.Name"
                            class="network-btn flex flex-col items-center gap-2 border-2 border-slate-200 rounded-xl p-4 hover:border-primary transition-all">
                        <div class="w-10 h-10 rounded-full @network.Color @network.TextColor flex items-center justify-center text-xs font-black">
                            @network.Name
                        </div>
                        <span class="text-xs font-semibold text-on-surface">@network.Name</span>
                    </button>
                }
            </div>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- Data plans (hidden until network selected) -->
        <div id="plansSection" class="hidden space-y-3">
            <label class="text-sm font-semibold text-on-surface">Select Data Plan</label>
            <div id="plansGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
        </div>

        <div id="plansDivider" class="hidden border-t border-slate-100"></div>

        <!-- Phone number -->
        <div class="space-y-2">
            <label class="text-sm font-semibold text-on-surface">Phone Number</label>
            <input id="phoneInput"
                   type="tel"
                   maxlength="11"
                   placeholder="e.g. 08012345678"
                   class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" />
        </div>

        <!-- Save as beneficiary -->
        <div class="flex items-start justify-between gap-4 pt-2">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px] mt-0.5">bookmark</span>
                <div>
                    <p class="text-sm font-semibold text-on-surface">Save as beneficiary</p>
                    <p class="text-xs text-on-surface-variant">Auto-fill this number for future purchases</p>
                </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer mt-1">
                <input type="checkbox" id="saveBeneficiary" class="sr-only peer" />
                <div class="w-10 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:bg-primary transition-colors"></div>
                <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-4"></div>
            </label>
        </div>

        <!-- Continue button -->
        <div class="pt-2 space-y-3">
            <button onclick="continueToReview()"
                    class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
                Continue to Review
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
            <p class="text-center text-xs text-on-surface-variant flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[14px]">lock</span>
                Secure encrypted transaction by LegendPay
            </p>
        </div>

    </div>

    <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-start gap-3">
        <span class="material-symbols-outlined text-blue-600 text-[18px] mt-0.5">info</span>
        <p class="text-xs text-blue-700">Data is activated instantly on the phone number provided. Please ensure the number and network are correct before proceeding.</p>
    </div>

</div>

@section Scripts {
    <script>
        // TODO: Replace with real API call when BillerOne data plans endpoint is integrated
        const dataPlans = {
            'MTN': [
                { label: '1GB', duration: '1 Day',   price: 300   },
                { label: '1GB', duration: '7 Days',  price: 500   },
                { label: '2GB', duration: '7 Days',  price: 700   },
                { label: '3GB', duration: '30 Days', price: 1000  },
                { label: '5GB', duration: '30 Days', price: 1500  },
                { label: '10GB',duration: '30 Days', price: 2500  },
                { label: '20GB',duration: '30 Days', price: 4000  },
                { label: '50GB',duration: '30 Days', price: 8000  },
            ],
            'Airtel': [
                { label: '750MB',duration: '1 Day',   price: 200   },
                { label: '1.5GB',duration: '7 Days',  price: 500   },
                { label: '3GB',  duration: '30 Days', price: 1000  },
                { label: '5GB',  duration: '30 Days', price: 1500  },
                { label: '10GB', duration: '30 Days', price: 2500  },
                { label: '20GB', duration: '30 Days', price: 4000  },
                { label: '40GB', duration: '30 Days', price: 7000  },
                { label: '75GB', duration: '30 Days', price: 12000 },
            ],
            'Glo': [
                { label: '1GB',  duration: '1 Day',   price: 300   },
                { label: '2GB',  duration: '7 Days',  price: 500   },
                { label: '5GB',  duration: '30 Days', price: 1000  },
                { label: '7.5GB',duration: '30 Days', price: 1500  },
                { label: '10GB', duration: '30 Days', price: 2000  },
                { label: '15GB', duration: '30 Days', price: 3000  },
                { label: '25GB', duration: '30 Days', price: 5000  },
                { label: '50GB', duration: '30 Days', price: 8000  },
            ],
            '9mobile': [
                { label: '1GB',  duration: '7 Days',  price: 500   },
                { label: '1.5GB',duration: '30 Days', price: 1000  },
                { label: '3.5GB',duration: '30 Days', price: 1500  },
                { label: '5GB',  duration: '30 Days', price: 2000  },
                { label: '11.5GB',duration:'30 Days', price: 4000  },
                { label: '15GB', duration: '30 Days', price: 5000  },
                { label: '27.5GB',duration:'30 Days', price: 8000  },
            ],
        };

        let selectedNetwork = '';
        let selectedPlan    = null;

        function selectNetwork(name) {
            selectedNetwork = name;
            selectedPlan    = null;

            document.querySelectorAll('.network-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'bg-primary/5');
                btn.classList.add('border-slate-200');
            });
            const selected = document.getElementById('network-' + name);
            if (selected) {
                selected.classList.remove('border-slate-200');
                selected.classList.add('border-primary', 'bg-primary/5');
            }

            renderPlans(name);
        }

        function renderPlans(network) {
            const plans  = dataPlans[network] || [];
            const grid   = document.getElementById('plansGrid');
            const section= document.getElementById('plansSection');
            const divider= document.getElementById('plansDivider');

            grid.innerHTML = plans.map((p, i) => `
                <button type="button"
                        onclick="selectPlan(${i}, '${network}')"
                        id="plan-${i}"
                        class="plan-btn border-2 border-slate-200 rounded-xl p-4 text-left hover:border-primary transition-all">
                    <p class="text-sm font-bold text-on-surface">${p.label}</p>
                    <p class="text-xs text-on-surface-variant mt-0.5">${p.duration}</p>
                    <p class="text-sm font-semibold text-primary mt-2">₦${p.price.toLocaleString()}</p>
                </button>
            `).join('');

            section.classList.remove('hidden');
            divider.classList.remove('hidden');
        }

        function selectPlan(index, network) {
            selectedPlan = dataPlans[network][index];

            document.querySelectorAll('.plan-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'bg-primary/5');
                btn.classList.add('border-slate-200');
            });
            const selected = document.getElementById('plan-' + index);
            if (selected) {
                selected.classList.remove('border-slate-200');
                selected.classList.add('border-primary', 'bg-primary/5');
            }
        }

        function continueToReview() {
            const phone = document.getElementById('phoneInput').value.trim();
            const save  = document.getElementById('saveBeneficiary').checked;

            if (!selectedNetwork) {
                alert('Please select a network provider.');
                return;
            }
            if (!selectedPlan) {
                alert('Please select a data plan.');
                return;
            }
            if (phone.length !== 11 || !/^\d+$/.test(phone)) {
                alert('Please enter a valid 11-digit phone number.');
                return;
            }

            const params = new URLSearchParams({
                network:         selectedNetwork,
                planLabel:       selectedPlan.label,
                planDuration:    selectedPlan.duration,
                amount:          selectedPlan.price,
                phoneNumber:     phone,
                saveBeneficiary: save
            });

            window.location.href = '/Home/InternetReview?' + params.toString();
        }
    </script>
}
