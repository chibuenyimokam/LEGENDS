@model LegendPay.Models.ViewModels.UserDashboard.PayBillsViewModel
@{
    ViewData["Title"] = "Pay a Bill";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    // Map API category names to routes
    string GetCategoryRoute(string category) => category?.ToUpper() switch
    {
        "ELECTRICITY" => Url.Action("SelectBiller", "Home", new { category = "ELECTRICITY" }) ?? "#",
        "AIRTIME" => Url.Action("PurchaseDetails", "Home", new { category = "AIRTIME" }) ?? "#",
        "DATA" => Url.Action("PurchaseDetails", "Home", new { category = "DATA" }) ?? "#",
        "DIGITALTV" => Url.Action("SelectBiller", "Home", new { category = "DIGITALTV" }) ?? "#",
        "EDUCATION" => Url.Action("SelectBiller", "Home", new { category = "EDUCATION" }) ?? "#",
        "GAMES" => Url.Action("PurchaseDetails", "Home", new { category = "GAMES" }) ?? "#",
        "TRANSPORT" => Url.Action("PurchaseDetails", "Home", new { category = "TRANSPORT" }) ?? "#",
        "OTHER UTILITIES" => Url.Action("OtherUtilities", "Home") ?? "#",
        _ => "#"
    };

    // Map API category names to Material Symbol icons
    string GetCategoryIcon(string category) => category?.ToUpper() switch
    {
        "ELECTRICITY" => "bolt",
        "AIRTIME" => "smartphone",
        "DATA" => "wifi",
        "DIGITALTV" => "tv",
        "EDUCATION" => "school",
        "GAMES" => "sports_esports",
        "TRANSPORT" => "commute",
        "OTHER UTILITIES" => "receipt_long",
        _ => "receipt_long"
    };

    // Friendly display names
    string GetDisplayName(string category) => category?.ToUpper() switch
    {
        "ELECTRICITY" => "Electricity",
        "AIRTIME" => "Airtime",
        "DATA" => "Internet / Data",
        "DIGITALTV" => "Digital TV",
        "EDUCATION" => "Education",
        "GAMES" => "Games",
        "TRANSPORT" => "Transport",
        "OTHER UTILITIES" => "Other Utilities",
        _ => category
    };
}

<div class="p-10 space-y-8 max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-on-surface tracking-tight">What would you like to pay for?</h2>
            <p class="text-sm text-on-surface-variant mt-1">Select a category to get started or search for your biller.</p>
        </div>
        <div class="bg-primary text-white rounded-xl px-5 py-3 shadow-sm">
            <p class="text-[11px] uppercase tracking-widest opacity-80">Wallet Balance</p>
            <p class="text-xl font-black mt-0.5">₦@Model.AvailableBalance.ToString("N2")</p>
        </div>
    </div>

    <div class="relative max-w-2xl">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
        <input type="text" class="w-full pl-11 pr-4 py-3 bg-surface border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" placeholder="Search for a biller (e.g. DSTV, MTN, IKEDC)" />
    </div>

    <!-- Recently Used & Favorites -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Recently Used &amp; Favorites</h3>
            <a href="#" class="text-xs text-primary font-bold hover:underline">Manage Favorites</a>
        </div>
        @if (Model.RecentFavorites != null && Model.RecentFavorites.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var biller in Model.RecentFavorites)
                {
                    <a href="#" class="bg-surface border border-slate-200 rounded-xl p-5 flex items-center justify-between hover:border-slate-300 transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center font-bold text-sm text-slate-600 uppercase">@(string.IsNullOrEmpty(biller.BillerName) ? "?" : biller.BillerName[..1])</div>
                            <div>
                                <p class="text-sm font-semibold text-on-surface">@biller.BillerName</p>
                                <p class="text-xs text-on-surface-variant">@biller.AccountNumber</p>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-on-surface-variant text-[18px]">chevron_right</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="bg-surface border border-slate-200 rounded-xl p-8 text-center text-sm text-on-surface-variant">
                No saved billers yet. Your favorites will appear here after your first payment.
            </div>
        }
    </div>

    <!-- Browse by Category — from API -->
    <div class="space-y-4">
        <h3 class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Browse by Category</h3>

        @if (Model.Categories != null && Model.Categories.Any())
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                @foreach (var cat in Model.Categories)
                {
                    <a href="@GetCategoryRoute(cat.Category)"
                       class="bg-surface border border-slate-200 rounded-xl p-6 flex flex-col items-center justify-center gap-3 text-center hover:border-primary hover:shadow-md transition-all group">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                            @if (!string.IsNullOrEmpty(cat.LogoUrl))
                            {
                                <img src="@cat.LogoUrl" alt="@cat.Category"
                                     class="w-7 h-7 object-contain"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block'" />
                                <span class="material-symbols-outlined hidden">@GetCategoryIcon(cat.Category)</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined">@GetCategoryIcon(cat.Category)</span>
                            }
                        </div>
                        <span class="text-sm font-semibold text-on-surface">@GetDisplayName(cat.Category)</span>
                    </a>
                }
            </div>
        }
        else
        {
            <!-- Fallback if API returns nothing -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                @foreach (var cat in new[] {
                    new { Name = "Electricity",     Category = "ELECTRICITY",     Icon = "bolt"           },
                    new { Name = "Airtime",         Category = "AIRTIME",         Icon = "smartphone"     },
                    new { Name = "Internet / Data", Category = "DATA",            Icon = "wifi"           },
                    new { Name = "Digital TV",      Category = "DIGITALTV",       Icon = "tv"             },
                    new { Name = "Education",       Category = "EDUCATION",       Icon = "school"         },
                    new { Name = "Games",           Category = "GAMES",           Icon = "sports_esports" },
                    new { Name = "Transport",       Category = "TRANSPORT",       Icon = "commute"        },
                    new { Name = "Other Utilities", Category = "OTHER UTILITIES", Icon = "receipt_long"   },
                })
                {
                    <a href="@GetCategoryRoute(cat.Category)"
                       class="bg-surface border border-slate-200 rounded-xl p-6 flex flex-col items-center justify-center gap-3 text-center hover:border-primary hover:shadow-md transition-all group">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">@cat.Icon</span>
                        </div>
                        <span class="text-sm font-semibold text-on-surface">@cat.Name</span>
                    </a>
                }
            </div>
        }
    </div>
</div>
