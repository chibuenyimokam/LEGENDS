@model LegendPay.Models.ViewModels.PayBillsViewModel
@{
    ViewData["Title"] = "Pay Bills";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LegendPay – Pay Bills</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/UserDashboard.css" />
    <link rel="stylesheet" href="~/css/Home/PayBills.css" />
</head>
<body>

    <!-- ── SIDEBAR (exact same as dashboard, Transactions is active) ── -->
    <aside class="sidebar" id="sidebar">
        <button class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>

        <div class="sidebar-brand">
            <h2 class="brand-text">User Central</h2>
            <p class="brand-sub">Management Portal</p>
        </div>

        <nav class="sidebar-nav">
            <a class="nav-item" href="@Url.Action("Dashboard", "Home")">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                <span class="nav-label">Overview</span>
            </a>
            <a class="nav-item active" href="@Url.Action("PayBills", "Home")">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                <span class="nav-label">Transactions</span>
            </a>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                <span class="nav-label">Analytics</span>
            </a>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                <span class="nav-label">Support</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="status-badge">
                <div class="status-dot"></div>
                <span class="brand-text">Account Status: Active</span>
            </div>
            <a class="nav-item" href="#">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                <span class="nav-label">Settings</span>
            </a>
            <a class="nav-item" href="/Accounts/Logout" style="color:#EF4444;">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                <span class="nav-label">Logout</span>
            </a>
        </div>
    </aside>

    <!-- ── MAIN CONTENT ── -->
    <main class="main" id="main-content">
        <div class="pb-wrapper">

            <!-- TOP BAR -->
            <div class="pb-topbar">
                <div class="pb-topbar-search">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" placeholder="Search accounts or bills..." />
                </div>
                <div class="pb-topbar-right">
                    <button class="pb-icon-btn">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
                    </button>
                    <div class="pb-user-badge">
                        <div class="pb-avatar">AC</div>
                        <div class="pb-user-info">
                            <span class="pb-user-name">@Model.UserName</span>
                            <span class="pb-user-tier">PREMIUM ACCOUNT</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PAGE CONTENT -->
            <div class="pb-content">

                <!-- HEADING -->
                <div class="pb-heading">
                    <h1>What would you like to pay for?</h1>
                    <p>Select a category to get started or search for your biller.</p>
                </div>

                <!-- BILLER SEARCH -->
                <div class="pb-search-wrap">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" class="pb-search" placeholder="Search for a biller (e.g. DSTV, MTN, IKEDC)" />
                </div>

                <!-- RECENTLY USED & FAVORITES -->
                @if (Model.RecentFavorites != null && Model.RecentFavorites.Any())
                {
                    <div class="pb-section">
                        <div class="pb-section-header">
                            <span class="pb-section-title">
                                <svg width="14" height="14" fill="#FBBF24" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                Recently Used &amp; Favorites
                            </span>
                            <a href="#" class="pb-manage-link">Manage Favorites</a>
                        </div>
                        <div class="pb-favorites">
                            @foreach (var biller in Model.RecentFavorites)
                            {
                                <div class="fav-card">
                                    <div class="fav-card-top">
                                        <div class="fav-logo">@biller.BillerName.Substring(0, 1)</div>
                                        <div class="fav-info">
                                            <span class="fav-name">@biller.BillerName</span>
                                            <span class="fav-acct">@biller.AccountNumber</span>
                                        </div>
                                    </div>
                                    <div class="fav-card-bottom">
                                        @if (!string.IsNullOrEmpty(biller.LastPaidLabel))
                                        {
                                            <span class="fav-meta">@biller.LastPaidLabel</span>
                                        }
                                        @if (!string.IsNullOrEmpty(biller.Tag))
                                        {
                                            <span class="fav-tag">@biller.Tag</span>
                                        }
                                        <svg class="fav-arrow" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- BROWSE BY CATEGORY -->
                <div class="pb-section">
                    <div class="pb-section-header">
                        <span class="pb-cat-title">BROWSE BY CATEGORY</span>
                    </div>
                    <div class="pb-categories">
                        @foreach (var cat in Model.Categories)
                        {
                            <button class="cat-card" data-category="@cat.Name">
                                <div class="cat-icon-wrap @cat.ColorClass">
                                    @Html.Raw(cat.SvgIcon)
                                </div>
                                <span class="cat-label">@cat.Name</span>
                            </button>
                        }
                    </div>
                </div>

            </div><!-- /pb-content -->
        </div><!-- /pb-wrapper -->
    </main>

    <script src="~/js/UserDashboard.js"></script>
    <script src="~/js/Home/PayBills.js"></script>
</body>
</html>
