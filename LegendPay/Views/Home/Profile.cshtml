@model LegendPay.Models.ViewModels.UserDashboard.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="flex-1 px-10 py-8 max-w-4xl w-full">

    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">My Profile</h2>
        <p class="text-sm text-on-surface-variant mt-1">Manage your personal details and security.</p>
    </div>

    @foreach (var (key, cls) in new[] { ("ProfileSuccess", "green"), ("ProfileError", "red"), ("PasswordSuccess", "green"), ("PasswordError", "red") })
    {
        if (TempData[key] != null)
        {
            <div class="mb-4 rounded-lg px-4 py-3 text-sm border @(cls == "green" ? "bg-green-50 border-green-200 text-green-800" : "bg-red-50 border-red-200 text-red-800")">@TempData[key]</div>
        }
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-surface border border-slate-200 rounded-xl p-6 text-center h-fit">
            <div class="w-20 h-20 rounded-full bg-primary text-white flex items-center justify-center text-2xl font-bold uppercase mx-auto mb-3">
                @(string.Concat((Model.FirstName + " " + Model.LastName).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])))
            </div>
            <p class="font-bold text-slate-900">@Model.FirstName @Model.LastName</p>
            <p class="text-xs text-on-surface-variant">@Model.Email</p>
            <div class="mt-3 inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full @(Model.IsEmailVerified ? "bg-green-50 text-green-700" : "bg-amber-50 text-amber-700")">
                <span class="material-symbols-outlined text-[14px]">@(Model.IsEmailVerified ? "verified" : "schedule")</span>
                @(Model.IsEmailVerified ? "Verified" : "Unverified")
            </div>
            <div class="mt-4 pt-4 border-t border-slate-100 text-left space-y-2">
                <div>
                    <p class="text-[11px] text-on-surface-variant uppercase tracking-wide">Account Number</p>
                    <p class="text-sm font-semibold text-slate-800">@(string.IsNullOrEmpty(Model.AccountNumber) ? "Pending activation" : Model.AccountNumber)</p>
                </div>
                <div>
                    <p class="text-[11px] text-on-surface-variant uppercase tracking-wide">Bank</p>
                    <p class="text-sm font-semibold text-slate-800">@(string.IsNullOrEmpty(Model.BankName) ? "—" : Model.BankName)</p>
                </div>
                <div>
                    <p class="text-[11px] text-on-surface-variant uppercase tracking-wide">Member Since</p>
                    <p class="text-sm font-semibold text-slate-800">@Model.MemberSince.ToString("MMM yyyy")</p>
                </div>
            </div>
        </div>

        <div class="md:col-span-2 space-y-6">

            <div class="bg-surface border border-slate-200 rounded-xl p-6">
                <h3 class="text-sm font-bold text-slate-900 mb-4">Personal details</h3>
                <form asp-controller="Home" asp-action="UpdateProfile" method="post" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">First name</label>
                            <input name="firstName" value="@Model.FirstName" required class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Last name</label>
                            <input name="lastName" value="@Model.LastName" required class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Phone number</label>
                        <input name="phoneNumber" value="@Model.PhoneNumber" required class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Email (read-only)</label>
                        <input value="@Model.Email" disabled class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm bg-slate-50 text-on-surface-variant" />
                    </div>
                    <button type="submit" class="h-11 px-6 bg-primary text-white font-semibold rounded-lg hover:bg-primary-container transition-colors">Save changes</button>
                </form>
            </div>

            <div class="bg-surface border border-slate-200 rounded-xl p-6">
                <h3 class="text-sm font-bold text-slate-900 mb-4">Change password</h3>
                <form asp-controller="Home" asp-action="ChangePassword" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Current password</label>
                        <input name="currentPassword" type="password" required class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">New password</label>
                            <input name="newPassword" type="password" required minlength="8" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Confirm new password</label>
                            <input name="confirmPassword" type="password" required minlength="8" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
                        </div>
                    </div>
                    <button type="submit" class="h-11 px-6 bg-slate-900 text-white font-semibold rounded-lg hover:bg-slate-800 transition-colors">Update password</button>
                </form>
            </div>
        </div>
    </div>
</div>
