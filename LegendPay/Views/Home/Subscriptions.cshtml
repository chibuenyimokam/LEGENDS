@model LegendPay.Models.ViewModels.UserDashboard.SubscriptionsViewModel
@{
    ViewData["Title"] = "Subscriptions";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-7xl">
    <div class="flex flex-col md:flex-row justify-between md:items-end gap-4">
        <div>
            <h2 class="text-3xl font-bold text-on-surface tracking-tight">Subscriptions</h2>
            <p class="text-on-surface-variant mt-1">Manage your active recurring payments and billers.</p>
        </div>
        <button type="button" id="newSubBtn" class="inline-flex items-center justify-center gap-2 bg-primary text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-[#083b72] transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add</span>
            New Subscription
        </button>
    </div>

    @if (TempData["SubSuccess"] != null)
    {
        <div class="rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm">@TempData["SubSuccess"]</div>
    }
    @if (TempData["SubError"] != null)
    {
        <div class="rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">@TempData["SubError"]</div>
    }

    <div id="newSubForm" class="hidden bg-surface border border-slate-200 rounded-2xl p-6">
        <h3 class="text-sm font-bold text-slate-900 mb-4">New subscription</h3>
        <form asp-controller="Home" asp-action="CreateSubscription" method="post" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Biller name</label>
                <input name="billerName" required placeholder="e.g. DSTV, IKEDC, MTN" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Category</label>
                <input name="billerCategory" placeholder="e.g. Cable TV, Electricity" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Account / meter / phone</label>
                <input name="accountReference" required placeholder="Number to pay" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Amount (₦)</label>
                <input name="amount" type="number" step="0.01" min="50" required placeholder="0.00" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm focus:ring-1 focus:ring-primary focus:border-primary" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Renews every</label>
                <select name="intervalDays" class="w-full h-11 px-3 border border-slate-200 rounded-lg text-sm bg-white focus:ring-1 focus:ring-primary focus:border-primary">
                    <option value="7">Weekly</option>
                    <option value="30" selected>Monthly</option>
                    <option value="90">Quarterly</option>
                    <option value="365">Yearly</option>
                </select>
            </div>
            <div class="flex items-end">
                <button type="submit" class="h-11 px-6 bg-primary text-white font-semibold rounded-lg hover:bg-primary-container transition-colors">Create subscription</button>
            </div>
        </form>
    </div>

    @if (Model.OverlapCount > 1 && Model.NextBillDue.HasValue)
    {
        <div class="flex items-center gap-4 bg-amber-50 border border-amber-300 p-4 rounded-xl">
            <div class="bg-amber-300 text-amber-900 p-2 rounded-lg flex items-center justify-center">
                <span class="material-symbols-outlined">warning</span>
            </div>
            <div class="flex-1">
                <p class="text-amber-900 font-semibold">Subscription Overlap: You have @Model.OverlapCount renewals scheduled for @Model.NextBillDue.Value.ToString("MMM d").</p>
                <p class="text-amber-800 text-sm opacity-80">Ensure your wallet is sufficiently funded to avoid service interruption.</p>
            </div>
        </div>
    }

    @if (Model.Subscriptions.Any())
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            @foreach (var sub in Model.Subscriptions)
            {
                <div class="bg-surface border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row gap-5">
                    <div class="w-14 h-14 rounded-xl bg-slate-100 flex items-center justify-center shrink-0 border border-slate-200 font-bold text-sm text-slate-600 uppercase">@sub.Badge</div>
                    <div class="flex-1">
                        <div class="flex justify-between items-start mb-2 gap-4">
                            <div>
                                <h3 class="font-bold text-lg text-on-surface">@sub.BillerName</h3>
                                <p class="text-xs text-on-surface-variant font-medium">@sub.BillerCategory</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xl font-black text-primary">₦@sub.Amount.ToString("N0")</p>
                                <p class="text-xs text-on-surface-variant">@sub.Cadence</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mt-4 py-4 border-y border-slate-200 border-dashed">
                            <div>
                                <p class="text-xs text-on-surface-variant">Next Renewal</p>
                                <p class="text-sm font-semibold text-on-surface">@sub.NextDueDate.ToString("MMM d, yyyy")</p>
                            </div>
                            <div class="flex items-center justify-end gap-3">
                                <span class="text-xs font-semibold text-on-surface-variant">Auto-renew</span>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer" @(sub.IsAutoPayEnabled ? "checked" : "") />
                                    <div class="w-9 h-5 bg-slate-200 rounded-full peer peer-checked:after:translate-x-4 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                                </label>
                            </div>
                        </div>
                        <div class="flex gap-3 mt-6">
                            <form asp-controller="Home" asp-action="CancelSubscription" method="post" class="flex-1" onsubmit="return confirm('Cancel this subscription?');">
                                <input type="hidden" name="id" value="@sub.Id" />
                                <button type="submit" class="w-full text-center py-2 text-sm font-semibold text-on-surface-variant border border-slate-200 rounded-lg hover:text-error hover:border-error transition-colors">Cancel subscription</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-surface border border-slate-200 rounded-xl p-12 flex flex-col items-center justify-center text-center gap-2">
            <span class="material-symbols-outlined text-slate-300 text-5xl">subscriptions</span>
            <p class="font-semibold text-on-surface">No active subscriptions</p>
            <p class="text-sm text-on-surface-variant">Add a recurring bill to start managing renewals here.</p>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-primary p-6 rounded-2xl text-white shadow-lg overflow-hidden relative">
            <div class="relative z-10">
                <p class="text-sm opacity-80">Total Monthly Spend</p>
                <h4 class="text-3xl font-black mt-1">₦@Model.TotalMonthlySpend.ToString("N0")</h4>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-white/10 text-9xl">account_balance_wallet</span>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
            <p class="text-sm text-on-surface-variant">Active Subscriptions</p>
            <h4 class="text-3xl font-black text-on-surface mt-1">@Model.ActiveCount</h4>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
            <p class="text-sm text-on-surface-variant">Next Bill Due</p>
            <h4 class="text-3xl font-black text-primary mt-1">@(Model.NextBillDue?.ToString("MMM d") ?? "—")</h4>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById('newSubBtn');
            var form = document.getElementById('newSubForm');
            if (btn && form) {
                btn.addEventListener('click', function () {
                    form.classList.toggle('hidden');
                    if (!form.classList.contains('hidden')) form.scrollIntoView({ behavior: 'smooth' });
                });
            }
        })();
    </script>
    @if (TempData["SubError"] != null)
    {
        <script>document.getElementById('newSubForm')?.classList.remove('hidden');</script>
    }
}
