@model LegendPay.Models.ViewModels.UserDashboard.ElectricitySuccessViewModel
@{
    ViewData["Title"] = "Payment Successful";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-4xl">

    <!-- 4-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">

            <!-- Step 1 — completed -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">
                    <span class="material-symbols-outlined text-[16px]">check</span>
                </div>
                <span class="text-xs font-medium text-on-surface-variant">Select Biller</span>
            </div>

            <div class="flex-1 h-px bg-primary mx-2"></div>

            <!-- Step 2 — completed -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">
                    <span class="material-symbols-outlined text-[16px]">check</span>
                </div>
                <span class="text-xs font-medium text-on-surface-variant">Enter Details</span>
            </div>

            <div class="flex-1 h-px bg-primary mx-2"></div>

            <!-- Step 3 — completed -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">
                    <span class="material-symbols-outlined text-[16px]">check</span>
                </div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>

            <div class="flex-1 h-px bg-primary mx-2"></div>

            <!-- Step 4 — active -->
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">
                    <span class="material-symbols-outlined text-[16px]">check</span>
                </div>
                <span class="text-xs font-semibold text-primary">Done</span>
            </div>

        </div>
    </div>

    <!-- Success card -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-10 flex flex-col items-center text-center space-y-4">

        <!-- Green check icon -->
        <div class="w-16 h-16 rounded-2xl bg-green-50 border border-green-100 flex items-center justify-center">
            <span class="material-symbols-outlined text-green-600" style="font-size:32px; font-variation-settings:'FILL' 1;">check_circle</span>
        </div>

        <!-- Title & amount -->
        <div class="space-y-1">
            <h2 class="text-2xl font-bold text-on-surface">Payment Successful</h2>
            <p class="text-3xl font-black text-primary">₦@Model.Amount.ToString("N2")</p>
            <p class="text-sm text-on-surface-variant">Paid to @Model.BillerFullName Prepaid</p>
            <p class="text-xs text-on-surface-variant">@Model.PaidAt.ToString("MMM dd, yyyy • hh:mm tt")</p>
        </div>

        <!-- Legend Points banner -->
        <div class="w-full bg-primary/5 border border-primary/10 rounded-xl px-5 py-3 flex items-center justify-center gap-2">
            <span>🎉</span>
            <p class="text-sm font-semibold text-primary">You earned @Model.PointsEarned Legend Points 🎉</p>
        </div>

        <!-- Transaction details -->
        <div class="w-full border border-slate-200 rounded-xl overflow-hidden text-left">
            <div class="divide-y divide-slate-100">
                <div class="flex justify-between items-center px-5 py-3.5">
                    <span class="text-sm text-on-surface-variant">Transaction Ref</span>
                    <span class="text-sm font-semibold text-on-surface">@Model.TransactionRef</span>
                </div>
                <div class="flex justify-between items-center px-5 py-3.5">
                    <span class="text-sm text-on-surface-variant">Biller</span>
                    <span class="text-sm font-semibold text-on-surface">@Model.BillerFullName Prepaid</span>
                </div>
                <div class="flex justify-between items-center px-5 py-3.5">
                    <span class="text-sm text-on-surface-variant">Meter Number</span>
                    <div class="text-right">
                        <p class="text-sm font-semibold text-on-surface">@Model.MeterNumber</p>
                    </div>
                </div>
                <div class="flex justify-between items-center px-5 py-3.5">
                    <span class="text-sm text-on-surface-variant">Payment Method</span>
                    <span class="text-sm font-semibold text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-primary text-[16px]">account_balance_wallet</span>
                        LegendPay Wallet
                    </span>
                </div>
            </div>
        </div>

        <!-- Electricity token -->
        <div class="w-full space-y-2">
            <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Electricity Token</p>
            <div class="border-2 border-dashed border-green-300 bg-green-50 rounded-xl px-6 py-5 space-y-3">
                <p class="text-2xl font-black text-on-surface tracking-widest">@Model.ElectricityToken</p>
                <button onclick="copyToken('@Model.ElectricityToken')"
                        class="flex items-center gap-1 text-xs font-semibold text-primary hover:underline mx-auto">
                    <span class="material-symbols-outlined text-[14px]">content_copy</span>
                    Tap to copy token
                </button>
            </div>
            <p class="text-xs text-on-surface-variant">Unit Value: @Model.UnitValue kWh</p>
        </div>

        <!-- Action buttons -->
        <div class="w-full grid grid-cols-3 gap-3 pt-2">
            <button class="flex flex-col items-center gap-1.5 border border-slate-200 rounded-xl py-4 hover:border-primary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-[20px]">download</span>
                <span class="text-xs font-semibold">Download</span>
            </button>
            <button class="flex flex-col items-center gap-1.5 border border-slate-200 rounded-xl py-4 hover:border-primary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-[20px]">share</span>
                <span class="text-xs font-semibold">Share</span>
            </button>
            <a href="@Url.Action("ElectricityDetails", "Home", new { billerName = Model.BillerName, billerFullName = Model.BillerFullName })"
                   class="flex flex-col items-center gap-1.5 border border-slate-200 rounded-xl py-4 hover:border-primary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-[20px]">replay</span>
                <span class="text-xs font-semibold">Re-pay</span>
            </a>
        </div>

        <!-- Back to dashboard -->
        <a href="@Url.Action("HomePage", "Home")"
               class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">dashboard</span>
            Back to Dashboard
        </a>

    </div>
</div>

@section Scripts {
    <script>
        function copyToken(token) {
            navigator.clipboard.writeText(token).then(() => {
                const toast = document.getElementById('copyToast');
                if (toast) {
                    toast.querySelector('span:last-child') && (toast.querySelector('span:last-child').textContent = 'Token copied');
                    toast.style.opacity = '1';
                    setTimeout(() => { toast.style.opacity = '0'; }, 2000);
                }
            });
        }
    </script>
}
