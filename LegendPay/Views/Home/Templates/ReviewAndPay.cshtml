@model LegendPay.Models.ViewModels.UserDashboard.ReviewAndPayViewModel
@{
    ViewData["Title"] = "Review & Pay";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    bool isFourStep = Model.IsFourStep;
}

<div class="p-10 space-y-8 max-w-4xl">

    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">Review Payment</h2>
        <p class="text-sm text-on-surface-variant mt-1">Confirm your payment details before proceeding.</p>
    </div>

    <!-- Progress bar — 4 step or 3 step -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">
            @if (isFourStep)
            {
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center">
                        <span class="material-symbols-outlined text-[16px]">check</span>
                    </div>
                    <span class="text-xs font-medium text-on-surface-variant">Select Biller</span>
                </div>
                <div class="flex-1 h-px bg-primary mx-2"></div>
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center">
                        <span class="material-symbols-outlined text-[16px]">check</span>
                    </div>
                    <span class="text-xs font-medium text-on-surface-variant">Biller Details</span>
                </div>
                <div class="flex-1 h-px bg-primary mx-2"></div>
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">3</div>
                    <span class="text-xs font-semibold text-primary">Review &amp; Pay</span>
                </div>
                <div class="flex-1 h-px bg-slate-200 mx-2"></div>
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">4</div>
                    <span class="text-xs font-medium text-on-surface-variant">Done</span>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center">
                        <span class="material-symbols-outlined text-[16px]">check</span>
                    </div>
                    <span class="text-xs font-medium text-on-surface-variant">Purchase Details</span>
                </div>
                <div class="flex-1 h-px bg-primary mx-2"></div>
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">2</div>
                    <span class="text-xs font-semibold text-primary">Review &amp; Pay</span>
                </div>
                <div class="flex-1 h-px bg-slate-200 mx-2"></div>
                <div class="flex flex-col items-center gap-1.5 flex-1">
                    <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                    <span class="text-xs font-medium text-on-surface-variant">Done</span>
                </div>
            }
        </div>
    </div>

    <!-- Review card -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-8 space-y-6">

        <!-- Biller header -->
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined">@Model.CategoryIcon</span>
            </div>
            <div>
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">@Model.CategoryDisplayName</p>
                <p class="text-sm font-semibold text-on-surface">@Model.BillerName</p>
            </div>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- Summary rows -->
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <span class="text-sm text-on-surface-variant">Provider</span>
                <span class="text-sm font-semibold text-on-surface">@Model.BillerName</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
            {
                <div class="flex justify-between items-center">
                    <span class="text-sm text-on-surface-variant">@Model.ReferenceLabel</span>
                    <span class="text-sm font-semibold text-on-surface">@Model.ReferenceNumber</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.CustomerName))
            {
                <div class="flex justify-between items-center">
                    <span class="text-sm text-on-surface-variant">Account Name</span>
                    <span class="text-sm font-semibold text-on-surface">@Model.CustomerName</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.PlanLabel))
            {
                <div class="flex justify-between items-center">
                    <span class="text-sm text-on-surface-variant">Plan / Package</span>
                    <span class="text-sm font-semibold text-on-surface">@Model.PlanLabel @(!string.IsNullOrEmpty(Model.PlanDuration) ? $"({Model.PlanDuration})" : "")</span>
                </div>
            }

            <div class="flex justify-between items-center">
                <span class="text-sm text-on-surface-variant">Amount</span>
                <span class="text-lg font-bold text-on-surface">₦@Model.Amount.ToString("N2")</span>
            </div>

            <div class="flex justify-between items-center">
                <span class="text-sm text-on-surface-variant">Payment Method</span>
                <span class="text-sm font-semibold text-on-surface flex items-center gap-1">
                    <span class="material-symbols-outlined text-primary text-[16px]">account_balance_wallet</span>
                    LegendPay Wallet
                </span>
            </div>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- Wallet balance -->
        <div class="flex items-center justify-between bg-slate-50 rounded-xl px-5 py-4">
            <div>
                <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Wallet Balance</p>
                <p class="text-lg font-bold text-on-surface mt-0.5">₦@Model.WalletBalance.ToString("N2")</p>
            </div>
            @if (Model.WalletBalance >= Model.Amount)
            {
                <div class="flex items-center gap-2 bg-green-50 border border-green-100 text-green-700 px-4 py-2 rounded-full">
                    <span class="material-symbols-outlined text-[16px]">check_circle</span>
                    <span class="text-xs font-semibold">Sufficient</span>
                </div>
            }
        </div>

        <!-- Pay form -->
        <form method="post" action="@Url.Action("ProcessPayment", "Home")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Category" value="@Model.Category" />
            <input type="hidden" name="BillerId" value="@Model.BillerId" />
            <input type="hidden" name="BillerName" value="@Model.BillerName" />
            <input type="hidden" name="PackageSlug" value="@Model.PackageSlug" />
            <input type="hidden" name="ReferenceNumber" value="@Model.ReferenceNumber" />
            <input type="hidden" name="CustomerName" value="@Model.CustomerName" />
            <input type="hidden" name="PlanLabel" value="@Model.PlanLabel" />
            <input type="hidden" name="PlanDuration" value="@Model.PlanDuration" />
            <input type="hidden" name="Amount" value="@Model.Amount" />
            <input type="hidden" name="WalletBalance" value="@Model.WalletBalance" />
            <input type="hidden" name="SaveBeneficiary" value="@Model.SaveBeneficiary" />
            <input type="hidden" name="IsFourStep" value="@Model.IsFourStep" />

            <div class="space-y-3 pt-2">
                <button type="submit"
                    @(Model.WalletBalance < Model.Amount ? "disabled" : "")
                        class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    <span class="material-symbols-outlined text-[18px]">lock</span>
                    Pay Now ₦@Model.Amount.ToString("N2")
                </button>
                @if (Model.WalletBalance < Model.Amount)
                {
                    <div class="flex items-center gap-2 bg-red-50 border border-red-100 text-red-700 px-4 py-3 rounded-xl">
                        <span class="material-symbols-outlined text-[18px]">warning</span>
                        <p class="text-xs font-medium">Your wallet balance is not sufficient for this transaction. Please fund your wallet and try again.</p>
                    </div>
                }
                <p class="text-center text-xs text-on-surface-variant flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">lock</span>
                    Secure encrypted transaction by LegendPay
                </p>
            </div>
        </form>

    </div>

    <!-- Back link -->
    <a href="javascript:history.back()"
       class="inline-flex items-center gap-1 text-sm text-on-surface-variant hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        Back
    </a>

</div>
