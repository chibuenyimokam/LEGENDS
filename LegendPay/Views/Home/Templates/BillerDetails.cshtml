@model LegendPay.Models.ViewModels.UserDashboard.BillerDetailsViewModel
@{
    ViewData["Title"] = Model.BillerName + " – Biller Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    // Label for the reference field changes per category
    var refLabel = Model.Category switch
    {
        "ELECTRICITY" => "Meter / Account Number",
        "DIGITALTV" => "Smartcard / IUC Number",
        "EDUCATION" => Model.BillerName switch
        {
            "JAMB" => "Registration Number",
            "WAEC" => "Exam Number",
            "NECO" => "Exam Number",
            "NABTEB" => "Exam Number",
            _ => "Student ID / Application Number"
        },
        _ => "Account / Reference Number"
    };

    var refPlaceholder = Model.Category switch
    {
        "ELECTRICITY" => "e.g. 01425589104",
        "DIGITALTV" => "e.g. 1234567890",
        "EDUCATION" => "e.g. 123456789",
        _ => "Enter reference number"
    };

    var categoryIcon = Model.Category switch
    {
        "ELECTRICITY" => "bolt",
        "DIGITALTV" => "tv",
        "EDUCATION" => "school",
        _ => "receipt_long"
    };
}

<div class="p-10 space-y-8 max-w-4xl">

    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">@Model.CategoryDisplayName</h2>
        <p class="text-sm text-on-surface-variant mt-1">Enter your details to continue.</p>
    </div>

    <!-- 4-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-[16px]">check</span>
                </div>
                <span class="text-xs font-medium text-on-surface-variant">Select Biller</span>
            </div>
            <div class="flex-1 h-px bg-primary mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-xs font-semibold text-primary">Biller Details</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">4</div>
                <span class="text-xs font-medium text-on-surface-variant">Done</span>
            </div>
        </div>
    </div>

    <!-- Main form card -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-8 space-y-6">

        <!-- Biller header -->
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">@categoryIcon</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">@Model.CategoryDisplayName</p>
                    <p class="text-sm font-semibold text-on-surface">@Model.BillerName</p>
                </div>
            </div>
            <a href="@Url.Action("SelectBiller", "Home", new { category = Model.Category })"
               class="text-xs text-primary font-semibold flex items-center gap-1 hover:underline">
                <span class="material-symbols-outlined text-[14px]">edit</span>
                Change
            </a>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- Reference input -->
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <label class="text-sm font-semibold text-on-surface">@refLabel</label>
            </div>
            <div class="relative">
                <input id="refInput" type="text" placeholder="@refPlaceholder"
                       class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none pr-28"
                       oninput="resetVerification()" />
                <button onclick="verifyReference()"
                        class="absolute right-2 top-1/2 -translate-y-1/2 bg-primary text-white text-xs font-semibold px-4 py-1.5 rounded-lg hover:bg-primary/90 transition-colors">
                    Verify
                </button>
            </div>
            <div id="verifiedBadge" class="hidden">
                <span class="inline-flex items-center gap-1 text-xs font-bold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    VERIFIED
                </span>
            </div>
        </div>

        <!-- Customer info -->
        <div id="customerInfo" class="hidden bg-green-50 border border-green-100 rounded-xl px-5 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                        <span class="material-symbols-outlined text-green-700 text-[16px]">person</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-green-700 uppercase tracking-widest">Account Name</p>
                        <p id="customerName" class="text-sm font-bold text-on-surface uppercase">@Model.CustomerName</p>
                    </div>
                </div>
                @if (Model.Category == "ELECTRICITY")
                {
                    <div class="text-right">
                        <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Location</p>
                        <p class="text-xs font-semibold text-on-surface">@Model.BillerLocation</p>
                    </div>
                }
            </div>
        </div>

        <!-- Digital TV package selection (only for DIGITALTV) -->
        @if (Model.Category == "DIGITALTV")
        {
            <div id="packageSection" class="hidden space-y-3">
                <label class="text-sm font-semibold text-on-surface">Select Package</label>
                <div id="packagesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    @foreach (var pkg in Model.Packages)
                    {
                        <button type="button"
                                onclick="selectPackage('@pkg.BillerItemId', '@pkg.Label', @pkg.Amount)"
                                id="pkg-@pkg.BillerItemId"
                                class="pkg-btn border-2 border-slate-200 rounded-xl p-4 text-left hover:border-primary transition-all">
                            <p class="text-sm font-bold text-on-surface">@pkg.Label</p>
                            @if (pkg.Amount > 0)
                            {
                                <p class="text-sm font-semibold text-primary mt-1">₦@pkg.Amount.ToString("N0")/month</p>
                            }
                            else
                            {
                                <p class="text-xs text-on-surface-variant mt-1">Enter amount</p>
                            }
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Amount input -->
        <div id="amountSection" class="hidden space-y-3">
            <label class="text-sm font-semibold text-on-surface">Amount to Pay (₦)</label>
            <div class="flex items-center gap-2 border border-slate-200 rounded-xl px-4 py-3 focus-within:ring-1 focus-within:ring-primary">
                <span class="text-sm font-bold text-on-surface-variant">₦</span>
                <input id="amountInput" type="number" min="100" placeholder="0.00"
                       class="flex-1 outline-none text-sm text-on-surface bg-transparent" />
            </div>
            @if (Model.Category == "ELECTRICITY")
            {
                <div class="flex gap-2 flex-wrap">
                    @foreach (var amt in new[] { "5,000", "10,000", "25,000", "50,000" })
                    {
                        <button type="button" onclick="setAmount('@amt')"
                                class="px-4 py-1.5 border border-slate-200 rounded-full text-xs font-semibold text-on-surface hover:border-primary hover:text-primary transition-colors">
                            ₦@amt
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Save as beneficiary -->
        <div class="flex items-start justify-between gap-4 pt-2">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px] mt-0.5">bookmark</span>
                <div>
                    <p class="text-sm font-semibold text-on-surface">Save as beneficiary</p>
                    <p class="text-xs text-on-surface-variant">Auto-fill for future payments</p>
                </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer mt-1">
                <input type="checkbox" id="saveBeneficiary" class="sr-only peer" />
                <div class="w-10 h-6 bg-slate-200 rounded-full peer peer-checked:bg-primary transition-colors"></div>
                <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-4"></div>
            </label>
        </div>

        <!-- Continue -->
        <div id="continueSection" class="hidden pt-2 space-y-3">
            <button onclick="continueToReview()"
                    class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
                Continue to Review
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
            <p class="text-center text-xs text-on-surface-variant flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[14px]">lock</span>
                Secure encrypted transaction by LegendPay
            </p>
        </div>

    </div>

    <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-start gap-3">
        <span class="material-symbols-outlined text-blue-600 text-[18px] mt-0.5">info</span>
        <p class="text-xs text-blue-700">
            @(Model.Category == "ELECTRICITY"
                ? "Ensure you enter the correct meter number. Tokens are generated immediately after payment."
                : Model.Category == "DIGITALTV"
                ? "Your subscription will be renewed immediately after payment."
                : "Ensure you enter the correct reference number. Payments are processed immediately.")
        </p>
    </div>

</div>

@section Scripts {
    <script>
        const category     = '@Model.Category';
        const customerName = '@Model.CustomerName';
        const billerId     = '@Model.BillerId';
        const billerName   = '@Model.BillerName';

        let selectedPackage = null;

        function selectPackage(billerItemId, label, amount) {
            selectedPackage = { billerItemId, label, amount };

            document.querySelectorAll('.pkg-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'bg-primary/5');
                btn.classList.add('border-slate-200');
            });
            const btn = document.getElementById('pkg-' + billerItemId);
            if (btn) { btn.classList.remove('border-slate-200'); btn.classList.add('border-primary', 'bg-primary/5'); }

            // Show amount section so user can confirm/enter amount
            document.getElementById('amountSection').classList.remove('hidden');
            const amountInput = document.getElementById('amountInput');
            if (amountInput && amount > 0) amountInput.value = amount;
        }

        function verifyReference() {
            const ref = document.getElementById('refInput').value.trim();
            if (ref.length < 6) { alert('Please enter a valid reference number.'); return; }

            // TODO: Replace with real API verification call when integrated

            document.getElementById('customerName').textContent = customerName;
            document.getElementById('verifiedBadge').classList.remove('hidden');
            document.getElementById('customerInfo').classList.remove('hidden');

            if (category === 'DIGITALTV') {
                document.getElementById('packageSection').classList.remove('hidden');
            } else {
                document.getElementById('amountSection').classList.remove('hidden');
            }
            document.getElementById('continueSection').classList.remove('hidden');
        }

        function resetVerification() {
            selectedPackage = null;
            ['verifiedBadge','customerInfo','packageSection','amountSection','continueSection']
                .forEach(id => { const el = document.getElementById(id); if (el) el.classList.add('hidden'); });
        }

        function setAmount(val) {
            const input = document.getElementById('amountInput');
            if (input) input.value = val.replace(',', '');
        }

        function continueToReview() {
            const ref  = document.getElementById('refInput').value.trim();
            const save = document.getElementById('saveBeneficiary').checked;
            let amount = '';

            if (category === 'DIGITALTV') {
                if (!selectedPackage) { alert('Please select a package.'); return; }
                amount = document.getElementById('amountInput')?.value.trim();
                if (!amount || parseFloat(amount) < 100) { alert('Please enter a valid amount (minimum ₦100).'); return; }
            } else {
                amount = document.getElementById('amountInput')?.value.trim();
                if (!amount || parseFloat(amount) < 100) { alert('Please enter a valid amount (minimum ₦100).'); return; }
            }

            const params = new URLSearchParams({
                category:        category,
                billerId:        billerId,
                billerName:      billerName,
                referenceNumber: ref,
                customerName:    customerName,
                packageLabel:    selectedPackage?.label ?? '',
                amount:          amount,
                saveBeneficiary: save
            });
            window.location.href = '/Home/ReviewAndPay?' + params.toString();
        }
    </script>
}