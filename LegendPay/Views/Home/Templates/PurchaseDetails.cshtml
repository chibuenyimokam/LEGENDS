@model LegendPay.Models.ViewModels.UserDashboard.PurchaseDetailsViewModel
@{
    ViewData["Title"] = Model.CategoryDisplayName + " – Purchase Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-4xl">

    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">@Model.CategoryDisplayName</h2>
        <p class="text-sm text-on-surface-variant mt-1">Select your provider and enter details to continue.</p>
    </div>

    <!-- 3-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</div>
                <span class="text-xs font-semibold text-primary">Purchase Details</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-xs font-medium text-on-surface-variant">Done</span>
            </div>
        </div>
    </div>

    <!-- Main form card -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-8 space-y-6">

        <!-- Provider selection -->
        <div class="space-y-3">
            <label class="text-sm font-semibold text-on-surface">Select Provider</label>

            @if (Model.Category == "AIRTIME" || Model.Category == "DATA")
            {
                <!-- Network provider cards for Airtime & Data  pulled from CoralPay's biller list -->
                <div class="grid grid-cols-4 gap-3">
                    @foreach (var biller in Model.Billers ?? new List<LegendPay.Models.ViewModels.UserDashboard.BillerItem>())
                    {
                        <button type="button" onclick="selectProvider('@biller.BillerName', '@biller.BillerId')" id="provider-@biller.BillerId"
                                class="provider-btn flex flex-col items-center gap-2 border-2 border-slate-200 rounded-xl p-4 hover:border-primary transition-all">
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-xs font-black text-primary">
                                @(biller.BillerName.Length >= 2 ? biller.BillerName.Substring(0, 2).ToUpper() : biller.BillerName.ToUpper())
                            </div>
                            <span class="text-xs font-semibold text-on-surface">@biller.BillerName</span>
                        </button>
                    }
                </div>
            }
            else if (Model.Category == "GAMES" || Model.Category == "TRANSPORT")
            {
                <!-- Biller cards with More popup for Games & Transport -->
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
                    @{
                        var mainBillers = Model.Billers?.Take(5).ToList() ?? new List<LegendPay.Models.ViewModels.UserDashboard.BillerItem>();
                        var moreBillers = Model.Billers?.Skip(5).ToList() ?? new List<LegendPay.Models.ViewModels.UserDashboard.BillerItem>();
                    }
                    @foreach (var biller in mainBillers)
                    {
                        <button type="button" onclick="selectProvider('@biller.BillerName', '@biller.BillerId')"
                                id="provider-@biller.BillerId"
                                class="provider-btn flex flex-col items-center gap-2 border-2 border-slate-200 rounded-xl p-3 hover:border-primary transition-all">
                            @if (!string.IsNullOrEmpty(biller.LogoUrl))
                            {
                                <img src="@biller.LogoUrl" alt="@biller.BillerName" class="w-10 h-10 rounded-full object-contain"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                <div class="w-10 h-10 rounded-full bg-slate-200 items-center justify-center text-xs font-black text-slate-700 hidden">
                                    @(biller.BillerName.Length >= 2 ? biller.BillerName.Substring(0, 2).ToUpper() : biller.BillerName.ToUpper())
                                </div>
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-xs font-black text-primary">
                                    @(biller.BillerName.Length >= 2 ? biller.BillerName.Substring(0, 2).ToUpper() : biller.BillerName.ToUpper())
                                </div>
                            }
                            <span class="text-xs font-semibold text-on-surface text-center leading-tight">@biller.BillerName</span>
                        </button>
                    }
                    @if (moreBillers.Any())
                    {
                        <button type="button" onclick="document.getElementById('moreModal').classList.remove('hidden')"
                                class="flex flex-col items-center gap-2 border-2 border-slate-200 rounded-xl p-3 hover:border-primary transition-all">
                            <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center">
                                <span class="material-symbols-outlined text-on-surface-variant">more_horiz</span>
                            </div>
                            <span class="text-xs font-semibold text-on-surface">More</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <!-- Generic biller list for other categories -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    @foreach (var biller in Model.Billers ?? new List<LegendPay.Models.ViewModels.UserDashboard.BillerItem>())
                    {
                        <button type="button" onclick="selectProvider('@biller.BillerName', '@biller.BillerId')"
                                id="provider-@biller.BillerId"
                                class="provider-btn flex flex-col items-center gap-3 border-2 border-slate-200 rounded-xl p-4 hover:border-primary transition-all">
                            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                <span class="material-symbols-outlined text-[18px]">@Model.CategoryIcon</span>
                            </div>
                            <span class="text-xs font-semibold text-on-surface text-center">@biller.BillerName</span>
                        </button>
                    }
                </div>
            }

            <!-- Selected provider display -->
            <div id="selectedProviderDisplay" class="hidden">
                <span class="inline-flex items-center gap-2 text-xs font-semibold text-primary bg-primary/5 border border-primary/20 px-3 py-1.5 rounded-full">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    Selected: <span id="selectedProviderName"></span>
                </span>
            </div>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- Data plans (only for DATA category) -->
        @if (Model.Category == "DATA")
        {
            <div id="plansSection" class="hidden space-y-3">
                <label class="text-sm font-semibold text-on-surface">Select Data Plan</label>
                <div id="plansGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
            </div>
            <div id="plansDivider" class="hidden border-t border-slate-100"></div>
        }

        <!-- Phone number (for Airtime & Data) or User ID (for Games) or reference (for Transport) -->
        @if (Model.Category == "AIRTIME" || Model.Category == "DATA")
        {
            <div class="space-y-2">
                <label class="text-sm font-semibold text-on-surface">Phone Number</label>
                <input id="refInput" type="tel" maxlength="11" placeholder="e.g. 08012345678"
                       class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" />
            </div>
        }
        else if (Model.Category == "GAMES")
        {
            <div class="space-y-2">
                <label class="text-sm font-semibold text-on-surface">User ID / Account Number</label>
                <input id="refInput" type="text" placeholder="Enter your betting platform user ID"
                       class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" />
            </div>
        }
        else if (Model.Category == "TRANSPORT")
        {
            <div class="space-y-2">
                <label class="text-sm font-semibold text-on-surface">Account / Reference Number</label>
                <input id="refInput" type="text" placeholder="Enter account or reference number"
                       class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" />
            </div>
        }

        <!-- Amount (hidden for DATA since plan sets the amount) -->
        @if (Model.Category != "DATA")
        {
            <div class="space-y-3">
                <label class="text-sm font-semibold text-on-surface">Amount (₦)</label>
                <div class="flex items-center gap-2 border border-slate-200 rounded-xl px-4 py-3 focus-within:ring-1 focus-within:ring-primary">
                    <span class="text-sm font-bold text-on-surface-variant">₦</span>
                    <input id="amountInput" type="number" min="50" placeholder="0.00"
                           class="flex-1 outline-none text-sm text-on-surface bg-transparent" />
                </div>
                <div class="flex gap-2 flex-wrap">
                    @if (Model.Category == "AIRTIME")
                    {
                        @foreach (var amt in new[] { "100", "200", "500", "1,000", "2,000", "5,000" })
                        {
                            <button type="button" onclick="setAmount('@amt')"
                                    class="px-4 py-1.5 border border-slate-200 rounded-full text-xs font-semibold text-on-surface hover:border-primary hover:text-primary transition-colors">
                                ₦@amt
                            </button>
                        }
                    }
                    else
                    {
                        @foreach (var amt in new[] { "500", "1,000", "2,000", "5,000", "10,000", "20,000" })
                        {
                            <button type="button" onclick="setAmount('@amt')"
                                    class="px-4 py-1.5 border border-slate-200 rounded-full text-xs font-semibold text-on-surface hover:border-primary hover:text-primary transition-colors">
                                ₦@amt
                            </button>
                        }
                    }
                </div>
            </div>
        }

        <!-- Save as beneficiary -->
        <div class="flex items-start justify-between gap-4 pt-2">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px] mt-0.5">bookmark</span>
                <div>
                    <p class="text-sm font-semibold text-on-surface">Save as beneficiary</p>
                    <p class="text-xs text-on-surface-variant">Auto-fill for future payments</p>
                </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer mt-1">
                <input type="checkbox" id="saveBeneficiary" class="sr-only peer" />
                <div class="w-10 h-6 bg-slate-200 rounded-full peer peer-checked:bg-primary transition-colors"></div>
                <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-4"></div>
            </label>
        </div>

        <!-- Continue -->
        <div class="pt-2 space-y-3">
            <button onclick="continueToReview()"
                    class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
                Continue to Review
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
            <p class="text-center text-xs text-on-surface-variant flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[14px]">lock</span>
                Secure encrypted transaction by LegendPay
            </p>
        </div>

    </div>

</div>

<!-- More providers modal (for Games & Transport) -->
@if ((Model.Category == "GAMES" || Model.Category == "TRANSPORT") && (Model.Billers?.Count > 5))
{
    <div id="moreModal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 backdrop-blur-sm">
        <div class="bg-surface w-full sm:max-w-lg rounded-t-2xl sm:rounded-2xl p-6 max-h-[80vh] flex flex-col">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-bold text-on-surface">More Providers</h3>
                <button onclick="document.getElementById('moreModal').classList.add('hidden')"
                        class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center hover:bg-slate-200 transition-colors">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
            <div class="overflow-y-auto space-y-2 flex-1">
                @foreach (var biller in Model.Billers?.Skip(5) ?? new List<LegendPay.Models.ViewModels.UserDashboard.BillerItem>())
                {
                    <button type="button"
                            onclick="selectProviderFromModal('@biller.BillerName', '@biller.BillerId')"
                            class="w-full flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 hover:border-primary transition-all text-left">
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-xs font-black text-primary flex-shrink-0">
                            @(biller.BillerName.Length >= 2 ? biller.BillerName.Substring(0, 2).ToUpper() : biller.BillerName.ToUpper())
                        </div>
                        <span class="text-sm font-semibold text-on-surface">@biller.BillerName</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const category = '@Model.Category';
        let selectedProvider   = '';
        let selectedProviderId = '';
        let selectedPlan       = null;   // { slug, label, amount } from CoralPay, for DATA
        let airtimePackage     = null;   // { slug, label } for AIRTIME - the *_AIRTIME package, custom amount

        async function fetchPackages(billerId) {
            const res = await fetch('/Home/GetPackagesForBiller?billerId=' + encodeURIComponent(billerId));
            if (!res.ok) return [];
            return await res.json();
        }

        async function selectProvider(name, id = '') {
            selectedProvider   = name;
            selectedProviderId = id;
            selectedPlan       = null;
            airtimePackage     = null;

            document.querySelectorAll('.provider-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'bg-primary/5');
                btn.classList.add('border-slate-200');
            });
            const btn = document.getElementById('provider-' + (id || name));
            if (btn) { btn.classList.remove('border-slate-200'); btn.classList.add('border-primary', 'bg-primary/5'); }

            document.getElementById('selectedProviderName').textContent = name;
            document.getElementById('selectedProviderDisplay').classList.remove('hidden');

            if (!id) return; // Games/Transport "More" modal items already carry an id; nothing further needed here

            if (category === 'DATA') {
                await renderPlans(id);
            } else if (category === 'AIRTIME') {
                // Find this biller's top-up package (amount is null/0 - customer enters their own amount)
                const packages = await fetchPackages(id);
                airtimePackage = packages.find(p => !p.amount || p.amount === 0) || null;
                if (!airtimePackage) {
                    console.warn('No airtime top-up package found for biller', id);
                }
            }
        }

        function selectProviderFromModal(name, id) {
            selectProvider(name, id);
            document.getElementById('moreModal')?.classList.add('hidden');
        }

        async function renderPlans(billerId) {
            const packages = await fetchPackages(billerId);
            // Data bundles are the packages with a real fixed price; the *_AIRTIME entry (amount null) is excluded
            const plans   = packages.filter(p => p.amount && p.amount > 0);
            const grid    = document.getElementById('plansGrid');
            const section = document.getElementById('plansSection');
            const divider = document.getElementById('plansDivider');
            if (!grid) return;

            grid.innerHTML = plans.map((p, i) => `
                <button type="button" id="plan-${i}"
                        class="plan-btn border-2 border-slate-200 rounded-xl p-4 text-left hover:border-primary transition-all">
                    <p class="text-sm font-bold text-on-surface">${p.label}</p>
                    <p class="text-sm font-semibold text-primary mt-2">₦${p.amount.toLocaleString()}</p>
                </button>
            `).join('');

            grid.querySelectorAll('.plan-btn').forEach((el, i) => {
                el.onclick = () => selectPlan(i, plans);
            });

            section?.classList.remove('hidden');
            divider?.classList.remove('hidden');
        }

        function selectPlan(index, plans) {
            selectedPlan = plans[index];
            document.querySelectorAll('.plan-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'bg-primary/5');
                btn.classList.add('border-slate-200');
            });
            const btn = document.getElementById('plan-' + index);
            if (btn) { btn.classList.remove('border-slate-200'); btn.classList.add('border-primary', 'bg-primary/5'); }
        }

        function setAmount(val) {
            const input = document.getElementById('amountInput');
            if (input) input.value = val.replace(',', '');
        }

        function continueToReview() {
            const ref  = document.getElementById('refInput')?.value.trim();
            const save = document.getElementById('saveBeneficiary').checked;
            let amount      = '';
            let planLabel   = '';
            let packageSlug = '';

            if (!selectedProvider) { alert('Please select a provider.'); return; }

            if (category === 'AIRTIME') {
                if (!ref) { alert('Please enter the required details.'); return; }
                amount = document.getElementById('amountInput')?.value.trim();
                if (!amount || parseFloat(amount) < 50) { alert('Please enter a valid amount.'); return; }
                if (!airtimePackage) { alert('Could not find a top-up package for this provider. Please try again.'); return; }
                packageSlug = airtimePackage.slug;
                planLabel   = airtimePackage.label;
            } else if (category === 'TRANSPORT') {
                if (!ref) { alert('Please enter the required details.'); return; }
                amount = document.getElementById('amountInput')?.value.trim();
                if (!amount || parseFloat(amount) < 50) { alert('Please enter a valid amount.'); return; }
            } else if (category === 'DATA') {
                if (!ref || ref.length !== 11) { alert('Please enter a valid 11-digit phone number.'); return; }
                if (!selectedPlan) { alert('Please select a data plan.'); return; }
                amount      = selectedPlan.amount;
                planLabel   = selectedPlan.label;
                packageSlug = selectedPlan.slug;
            } else if (category === 'GAMES') {
                if (!ref) { alert('Please enter your User ID.'); return; }
                amount = document.getElementById('amountInput')?.value.trim();
                if (!amount || parseFloat(amount) < 100) { alert('Please enter a valid amount.'); return; }
            }

            const params = new URLSearchParams({
                category:        category,
                billerId:        selectedProviderId,
                billerName:      selectedProvider,
                packageSlug:     packageSlug,
                referenceNumber: ref,
                planLabel:       planLabel,
                planDuration:    '',
                amount:          amount,
                saveBeneficiary: save
            });
            window.location.href = '/Home/ReviewAndPay?' + params.toString();
        }
    </script>
}
