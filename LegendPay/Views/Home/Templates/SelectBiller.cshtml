@model LegendPay.Models.ViewModels.UserDashboard.SelectBillerViewModel
@{
    ViewData["Title"] = Model.CategoryDisplayName + " – Select Biller";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-4xl">

    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">@Model.CategoryDisplayName</h2>
        <p class="text-sm text-on-surface-variant mt-1">Select a provider to continue.</p>
    </div>

    <!-- 4-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</div>
                <span class="text-xs font-semibold text-primary">Select Biller</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-xs font-medium text-on-surface-variant">Biller Details</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">4</div>
                <span class="text-xs font-medium text-on-surface-variant">Done</span>
            </div>
        </div>
    </div>

    <!-- Biller grid -->
    <div class="space-y-4">
        <h3 class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Select Provider</h3>

        @if (Model.Billers != null && Model.Billers.Any())
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                @foreach (var biller in Model.Billers)
                {
                    <a href="@Url.Action("BillerDetails", "Home", new { category = Model.Category, billerId = biller.BillerId, billerName = biller.BillerName, referenceIdVerifiable = biller.ReferenceIdVerifiable, amountInVerification = biller.AmountInVerification })"
                       class="bg-surface border border-slate-200 rounded-xl p-6 flex flex-col items-center justify-center gap-3 text-center hover:border-primary hover:shadow-md transition-all group">
                        @if (!string.IsNullOrEmpty(biller.LogoUrl))
                        {
                            <img src="@biller.LogoUrl" alt="@biller.BillerName"
                                 class="w-12 h-12 rounded-xl object-contain"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                            <div class="w-12 h-12 rounded-xl bg-primary/10 items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors hidden">
                                <span class="material-symbols-outlined">@Model.CategoryIcon</span>
                            </div>
                        }
                        else
                        {
                            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                                <span class="material-symbols-outlined">@Model.CategoryIcon</span>
                            </div>
                        }
                        <div>
                            <p class="text-sm font-semibold text-on-surface">@biller.BillerName</p>
                            @if (!string.IsNullOrEmpty(biller.Description))
                            {
                                <p class="text-xs text-on-surface-variant mt-0.5">@biller.Description</p>
                            }
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="bg-surface border border-slate-200 rounded-xl p-8 text-center text-sm text-on-surface-variant">
                No billers available at the moment. Please try again later.
            </div>
        }
    </div>

</div>
