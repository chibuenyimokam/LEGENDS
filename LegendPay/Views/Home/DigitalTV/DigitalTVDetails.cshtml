@model LegendPay.Models.ViewModels.UserDashboard.DigitalTVDetailsViewModel
@{
    ViewData["Title"] = "Digital TV – Enter Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="p-10 space-y-8 max-w-4xl">

    <div>
        <h2 class="text-2xl font-bold text-on-surface tracking-tight">Digital TV</h2>
        <p class="text-sm text-on-surface-variant mt-1">Enter your smartcard details and select a package.</p>
    </div>

    <!-- 4-step progress bar -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-6">
        <div class="flex items-center justify-between">
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">
                    <span class="material-symbols-outlined text-[16px]">check</span>
                </div>
                <span class="text-xs font-medium text-on-surface-variant">Select Provider</span>
            </div>
            <div class="flex-1 h-px bg-primary mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">2</div>
                <span class="text-xs font-semibold text-primary">Enter Details</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">3</div>
                <span class="text-xs font-medium text-on-surface-variant">Review &amp; Pay</span>
            </div>
            <div class="flex-1 h-px bg-slate-200 mx-2"></div>
            <div class="flex flex-col items-center gap-1.5 flex-1">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-on-surface-variant flex items-center justify-center text-sm font-bold">4</div>
                <span class="text-xs font-medium text-on-surface-variant">Done</span>
            </div>
        </div>
    </div>

    <!-- Main form card -->
    <div class="bg-surface border border-slate-200 rounded-2xl p-8 space-y-6">

        <!-- Provider header -->
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center">
                    <span class="material-symbols-outlined text-blue-600">tv</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Digital TV</p>
                    <p class="text-sm font-semibold text-on-surface">@Model.ProviderFullName</p>
                </div>
            </div>
            <a href="@Url.Action("DigitalTVBillers", "Home")"
                   class="text-xs text-primary font-semibold flex items-center gap-1 hover:underline">
                <span class="material-symbols-outlined text-[14px]">edit</span>
                Change Provider
            </a>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- Smartcard / IUC number -->
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <label class="text-sm font-semibold text-on-surface">Smartcard / IUC Number</label>
                <span class="text-xs text-on-surface-variant">e.g. 1234567890</span>
            </div>
            <div class="relative">
                <input id="smartcardInput"
                       type="text"
                       placeholder="Enter smartcard number"
                       class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none pr-28"
                       oninput="resetVerification()" />
                <button onclick="verifySmartcard()"
                        class="absolute right-2 top-1/2 -translate-y-1/2 bg-primary text-white text-xs font-semibold px-4 py-1.5 rounded-lg hover:bg-primary/90 transition-colors">
                    Verify
                </button>
            </div>
            <div id="verifiedBadge" class="hidden">
                <span class="inline-flex items-center gap-1 text-xs font-bold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    VERIFIED
                </span>
            </div>
        </div>

        <!-- Customer info -->
        <div id="customerInfo" class="hidden bg-green-50 border border-green-100 rounded-xl px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                    <span class="material-symbols-outlined text-green-700 text-[16px]">person</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-green-700 uppercase tracking-widest">Account Name</p>
                    <p id="customerName" class="text-sm font-bold text-on-surface uppercase">@Model.CustomerName</p>
                </div>
            </div>
        </div>

        <!-- Package selection -->
        <div id="packageSection" class="hidden space-y-3">
            <label class="text-sm font-semibold text-on-surface">Select Package</label>
            <div id="packagesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
        </div>

        <!-- Save as beneficiary -->
        <div class="flex items-start justify-between gap-4 pt-2">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px] mt-0.5">bookmark</span>
                <div>
                    <p class="text-sm font-semibold text-on-surface">Save as beneficiary</p>
                    <p class="text-xs text-on-surface-variant">Auto-fill this for future renewals</p>
                </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer mt-1">
                <input type="checkbox" id="saveBeneficiary" class="sr-only peer" />
                <div class="w-10 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:bg-primary transition-colors"></div>
                <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-4"></div>
            </label>
        </div>

        <!-- Continue button -->
        <div id="continueSection" class="hidden pt-2 space-y-3">
            <button onclick="continueToReview()"
                    class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
                Continue to Review
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
            <p class="text-center text-xs text-on-surface-variant flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[14px]">lock</span>
                Secure encrypted transaction by LegendPay
            </p>
        </div>

    </div>

    <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-start gap-3">
        <span class="material-symbols-outlined text-blue-600 text-[18px] mt-0.5">info</span>
        <p class="text-xs text-blue-700">Your subscription will be renewed immediately after payment. Ensure you enter the correct smartcard/IUC number.</p>
    </div>

</div>

@section Scripts {
    <script>
        // TODO: Replace with real API call when BillerOne TV packages endpoint is integrated
        const packages = {
            'DSTV': [
                { label: 'Padi',      price: 2500  },
                { label: 'Yanga',     price: 3500  },
                { label: 'Confam',    price: 6200  },
                { label: 'Compact',   price: 10500 },
                { label: 'Compact+',  price: 16600 },
                { label: 'Premium',   price: 29500 },
            ],
            'GOTV': [
                { label: 'Smallie',   price: 1575  },
                { label: 'Jinja',     price: 2715  },
                { label: 'Jolli',     price: 4115  },
                { label: 'Max',       price: 5500  },
                { label: 'Supa',      price: 6400  },
            ],
            'STARTIMES': [
                { label: 'Nova',      price: 1300  },
                { label: 'Basic',     price: 2000  },
                { label: 'Smart',     price: 2600  },
                { label: 'Classic',   price: 3000  },
                { label: 'Super',     price: 5000  },
            ],
        };

        const providerName = '@Model.ProviderName';
        const customerName = '@Model.CustomerName';
        let selectedPackage = null;

        // Render packages on page load
        renderPackages();

        function renderPackages() {
            const plans = packages[providerName] || [];
            const grid  = document.getElementById('packagesGrid');
            grid.innerHTML = plans.map((p, i) => `
                <button type="button"
                        onclick="selectPackage(${i})"
                        id="pkg-${i}"
                        class="pkg-btn border-2 border-slate-200 rounded-xl p-4 text-left hover:border-primary transition-all">
                    <p class="text-sm font-bold text-on-surface">${p.label}</p>
                    <p class="text-sm font-semibold text-primary mt-1">₦${p.price.toLocaleString()}/month</p>
                </button>
            `).join('');
        }

        function selectPackage(index) {
            const plans = packages[providerName] || [];
            selectedPackage = plans[index];

            document.querySelectorAll('.pkg-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'bg-primary/5');
                btn.classList.add('border-slate-200');
            });
            const selected = document.getElementById('pkg-' + index);
            if (selected) {
                selected.classList.remove('border-slate-200');
                selected.classList.add('border-primary', 'bg-primary/5');
            }
        }

        function verifySmartcard() {
            const card = document.getElementById('smartcardInput').value.trim();
            if (card.length < 6) {
                alert('Please enter a valid smartcard/IUC number.');
                return;
            }

            // ─────────────────────────────────────────────────────────
            // TODO: Replace mock with real API call when integrated
            // ─────────────────────────────────────────────────────────
            document.getElementById('customerName').textContent = customerName;
            // END MOCK

            document.getElementById('verifiedBadge').classList.remove('hidden');
            document.getElementById('customerInfo').classList.remove('hidden');
            document.getElementById('packageSection').classList.remove('hidden');
            document.getElementById('continueSection').classList.remove('hidden');
        }

        function resetVerification() {
            selectedPackage = null;
            document.getElementById('verifiedBadge').classList.add('hidden');
            document.getElementById('customerInfo').classList.add('hidden');
            document.getElementById('packageSection').classList.add('hidden');
            document.getElementById('continueSection').classList.add('hidden');
        }

        function continueToReview() {
            const card = document.getElementById('smartcardInput').value.trim();
            const save = document.getElementById('saveBeneficiary').checked;

            if (!selectedPackage) {
                alert('Please select a package.');
                return;
            }

            const params = new URLSearchParams({
                providerName:     providerName,
                providerFullName: '@Model.ProviderFullName',
                smartcardNumber:  card,
                customerName:     customerName,
                packageLabel:     selectedPackage.label,
                amount:           selectedPackage.price,
                saveBeneficiary:  save
            });

            window.location.href = '/Home/DigitalTVReview?' + params.toString();
        }
    </script>
}
